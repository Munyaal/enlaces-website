---
/**
 * testimonioCard.astro
 *
 * Tarjeta individual del carrusel de testimonios de la sección "Opiniones".
 *
 * Rediseño inspirado en Google Reviews: jerarquía tipo review con
 * encabezado (avatar + nombre + rol), fila de estrellas amarillas,
 * mensaje legible y una insignia que indica la publicación en Google.
 *
 * El contenido (name, message, foto, rol) lo siguen aportando los
 * props del componente padre (`Testimonio.astro`); aquí solo se
 * maqueta la presentación.
 */

import { Icon } from "astro-icon/components";

const { name, message, foto, rol } = Astro.props;

// Las reseñas mostradas son 5/5; lo dejamos explícito para que las
// tecnologías de asistencia anuncien la calificación correctamente.
const rating = 5;
const ratingMax = 5;
---

<article
  class="relative flex h-full flex-col rounded-2xl border border-slate-200 bg-light p-5 shadow-sm transition-shadow duration-300 hover:shadow-md sm:p-6"
  aria-label={`Opinión de ${name}`}
>
  {/* Encabezado: avatar + nombre/rol a la izquierda, insignia Google a la derecha */}
  <header class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-center gap-3">
      <img
        src={foto}
        alt={name}
        loading="lazy"
        decoding="async"
        width="56"
        height="56"
        class="h-12 w-12 shrink-0 rounded-full border border-slate-200 object-cover sm:h-14 sm:w-14"
      />
      <div class="min-w-0">
        <h3 class="truncate font-bold text-secondary text-base leading-tight sm:text-lg">
          {name}
        </h3>
        {/* Dato secundario (rol) */}
        <p class="mt-0.5 line-clamp-2 text-xs text-slate-500 sm:text-sm">
          {rol}
        </p>
      </div>
    </div>

    {/* Indicador visual de Google */}
    <div
      class="flex shrink-0 items-center gap-1.5 rounded-full border border-slate-200 bg-light px-2 py-1 text-[11px] font-semibold uppercase tracking-wide text-slate-500"
      aria-label="Reseña publicada en Google"
    >
      <Icon
        name="brand-google"
        class="h-3.5 w-3.5"
        style="color:#4285F4"
        aria-hidden="true"
      />
      <span>Google</span>
    </div>
  </header>

  {/* Estrellas amarillas (oculto para SR, anunciado vía aria-label) */}
  <div
    class="mt-3 flex items-center gap-0.5"
    role="img"
    aria-label={`Calificación: ${rating} de ${ratingMax} estrellas`}
  >
    {
      Array.from({ length: ratingMax }, () => (
        <Icon
          name="star-filled"
          class="h-4 w-4 sm:h-5 sm:w-5"
          style="color:#FBBC05"
          aria-hidden="true"
        />
      ))
    }
  </div>

  {/* Mensaje del testimonio */}
  <blockquote
    class="mt-3 flex-1 text-sm leading-relaxed text-slate-700 sm:text-base"
  >
    {message}
  </blockquote>
</article>