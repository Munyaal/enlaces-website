---
/**
 * PhoneCTAButton.astro
 *
 * Botón CTA tipo píldora orientado a un canal telefónico. Mantiene la
 * composición visual usada en `WhyChooseUs.astro` (borde naranja, texto
 * "Llámanos" arriba, número destacado, círculo naranja con `arrow-right`)
 * y la expone como componente reutilizable controlado por props.
 *
 * Props:
 *   - label:      Texto superior (etiqueta visible).
 *   - phone:      Número de teléfono a mostrar destacado.
 *   - href:       Enlace de marcación (`tel:`).
 *   - ariaLabel:  Etiqueta accesible opcional; por defecto combina
 *                 `label` + `phone`.
 *   - class:      Clases adicionales para el contenedor.
 */

import IconArrowRight from "../../icons/arrow-right.svg";

interface Props {
  label?: string;
  phone?: string;
  href?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  label = "Llámanos",
  phone = "984 109 1111",
  href = "tel:+529841091111",
  ariaLabel,
  class: className = "",
}: Props = Astro.props;

const computedAriaLabel = ariaLabel ?? `Llámanos al ${phone}`;
---

<a
  href={href}
  aria-label={computedAriaLabel}
  class:list={[
    "inline-flex w-full max-w-sm items-center justify-between gap-4 rounded-full border-2 border-primary px-5 py-2 shadow-md transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light sm:w-auto sm:gap-6 sm:px-6",
    className,
  ]}
>
  <span class="flex flex-col text-left text-secondary">
    <span class="paragraph-sm font-medium">{label}</span>
    <span class="heading-5 uppercase">
      {phone}
    </span>
  </span>

  <span
    aria-hidden="true"
    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-light"
  >
    <IconArrowRight class="h-8 w-8" />
  </span>
</a>
