---
/**
 * CTAButton.astro
 */
import { Icon } from "astro-icon/components";
import IconArrowRight from "../../icons/arrow-right.svg";
import {
  BUTTON_BASE_CLASSES,
  BUTTON_SCALE_CLASSES,
  BUTTON_SHADOW_CLASSES,
  BUTTON_STATE_CLASSES,
  BUTTON_TRANSITION_CLASSES,
} from "./button-styles";

type Variant = "solid" | "navy" | "orange";

type Size = "sm" | "md";

interface Props {
  as?: "a" | "button";
  variant?: Variant;
  size?: Size;
  href?: string;
  type?: "button" | "submit" | "reset";
  loading?: boolean;
  disabled?: boolean;
  ariaLabel?: string;
  target?: "_blank" | "_self";
  rel?: string;
  id?: string;
  class?: string;
}

const {
  as = "a",
  variant = "solid",
  size = "md",
  href,
  type = "button",
  loading = false,
  disabled = false,
  ariaLabel,
  target,
  rel,
  id,
  class: className = "",
}: Props = Astro.props;

// Clases separadas para botón y círculo, replicando las dos ramas de
// `plan.tipo === "empresarial" ? … : …` en Plans.astro.
const variantClasses: Record<Variant, { button: string; circle: string }> = {
  navy: {
    button: "bg-secondary text-light border border-white",
    circle: "border-white/30 bg-light text-primary",
  },
  solid: {
    button: "bg-secondary text-light border border-accent",
    circle: "border-white/30 bg-accent text-secondary",
  },
  orange: {
    button:
      "bg-primary text-light border border-primary hover:bg-light hover:text-primary",
    circle:
      "border-primary/25 bg-light text-primary transition-colors duration-200 group-hover:border-primary group-hover:bg-primary group-hover:text-light",
  },
};

const sharedClasses = [
  BUTTON_BASE_CLASSES,
  BUTTON_TRANSITION_CLASSES,
  BUTTON_SCALE_CLASSES,
  BUTTON_SHADOW_CLASSES.elevated,
  "group w-full justify-center gap-2 sm:w-auto",
  "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light",
].join(" ");

const sizeClasses: Record<Size, string> = {
  md: "px-6 py-3 paragraph-md",
  sm: "px-5 py-2.5 paragraph-sm",
};

const circleSizes: Record<Size, { circle: string; icon: string }> = {
  md: { circle: "h-8 w-8", icon: "h-6 w-6" },
  sm: { circle: "h-7 w-7", icon: "h-5 w-5" },
};

const circleClasses = [
  "inline-flex items-center justify-center rounded-full border",
  circleSizes[size].circle,
].join(" ");

const arrowIconClasses = circleSizes[size].icon;

const stateClasses = BUTTON_STATE_CLASSES;

const isDisabled = disabled || loading;
const classes = variantClasses[variant];
const finalClass = [
  sharedClasses,
  sizeClasses[size],
  classes.button,
  stateClasses,
  isDisabled ? "pointer-events-none" : "",
  className,
]
  .filter(Boolean)
  .join(" ");
---

{
  as === "a" ? (
    <a
      href={isDisabled ? undefined : href}
      aria-disabled={isDisabled ? "true" : undefined}
      aria-busy={loading ? "true" : undefined}
      aria-label={ariaLabel}
      target={target}
      rel={target === "_blank" ? (rel ?? "noopener noreferrer") : rel}
      id={id}
      class={finalClass}
    >
      <slot />
      {loading ? (
        <span class={`${circleClasses} ${classes.circle}`} aria-hidden="true">
          <Icon
            name="loader"
            class={`${arrowIconClasses} animate-spin motion-reduce:animate-none`}
          />
        </span>
      ) : (
        <span class={`${circleClasses} ${classes.circle}`} aria-hidden="true">
          <IconArrowRight class={arrowIconClasses} />
        </span>
      )}
    </a>
  ) : (
    <button
      type={type}
      disabled={isDisabled}
      aria-busy={loading ? "true" : undefined}
      aria-label={ariaLabel}
      id={id}
      class={finalClass}
    >
      <slot />
      {loading ? (
        <span class={`${circleClasses} ${classes.circle}`} aria-hidden="true">
          <Icon
            name="loader"
            class={`${arrowIconClasses} animate-spin motion-reduce:animate-none`}
          />
        </span>
      ) : (
        <span class={`${circleClasses} ${classes.circle}`} aria-hidden="true">
          <IconArrowRight class={arrowIconClasses} />
        </span>
      )}
    </button>
  )
}
