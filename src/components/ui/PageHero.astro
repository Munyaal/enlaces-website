---
/**
 * PageHero.astro
 *
 * Hero centrado reutilizable para páginas internas: imagen decorativa a
 * sangre, overlay plano y contenido centrado con la altura de navbar ya
 * compensada. Existe para que blog (y luego otras páginas internas) no
 * dupliquen el mismo `<header>`.
 *
 * Contrato de altura (el alto es del componente, no del contenido):
 *   - 600px en tablet (`sm`/`md`) y 560px en laptop/escritorio (`lg`),
 *     medidos sobre el hero de blog, que es la referencia visual.
 *   - `min-h` y no `height`: si un título futuro es más largo, la caja
 *     crece en lugar de recortarse contra `overflow-hidden`.
 *   - En móvil el contenido manda: el hero crece con títulos largos
 *     (p. ej. /nosotros) para no partir el H1 ni taparlo con el navbar.
 *   - El header es una columna flex y el contenedor interno usa `flex-1`
 *     + `justify-center`; un `h-full` no resolvería contra un `min-h`.
 *   - `pt-24` (96px) libra el navbar fijo (64px móvil / 88px desktop);
 *     el `mt-16 sm:mt-20` anterior era el parche que inflaba el alto.
 *
 * Props:
 *   - scope:            valor de `data-reveal-scope`/`data-page-hero`.
 *   - image/alt/priority: imagen de fondo y su prioridad de carga.
 *   - titleId:          id opcional del `<h1>`.
 *   - overlayClass:     color del overlay (default `bg-secondary/65`).
 *   - descriptionClass: tipografía/medidas del párrafo descriptivo.
 *   - class:            clases extra para el `<header>`.
 *
 * Slots: default va dentro del `<h1>`; `description` es el párrafo.
 */
import { Image } from "astro:assets";

interface Props {
  scope: string;
  image: ImageMetadata;
  alt?: string;
  priority?: boolean;
  titleId?: string;
  overlayClass?: string;
  descriptionClass?: string;
  class?: string;
}

const {
  scope,
  image,
  alt = "",
  priority = false,
  titleId,
  overlayClass = "bg-secondary/65",
  descriptionClass = "mx-auto mt-5 max-w-3xl text-pretty text-light/90",
  class: className = "",
} = Astro.props;

const headerClasses = [
  "relative isolate flex w-full flex-col min-h-[560px] overflow-hidden bg-secondary sm:min-h-[600px] lg:min-h-[560px]",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<header
  data-page-hero={scope}
  data-reveal-scope={scope}
  class={headerClasses}
>
  <Image
    src={image}
    alt={alt}
    aria-hidden="true"
    priority={priority}
    widths={[480, 768, 1024, 1600]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover brightness-75"
  />

  <div aria-hidden="true" class={"absolute inset-0 -z-10 " + overlayClass}>
  </div>

  <div
    class="relative mx-auto flex w-full max-w-7xl flex-1 flex-col items-center justify-center px-6 pt-24 pb-10"
  >
    <div class="w-full text-center">
      <h1
        id={titleId}
        class="heading-1 mt-3 text-balance text-light"
        data-reveal
      >
        <slot />
      </h1>
      <hr
        aria-hidden="true"
        class="mx-auto mt-4 h-1 w-32 border-0 bg-accent-grad-radial sm:w-52"
        data-reveal
      />
      {
        Astro.slots.has("description") && (
          <p class={descriptionClass} data-reveal>
            <slot name="description" />
          </p>
        )
      }
    </div>
  </div>
</header>

<script>
  import { revealHero, whenReady } from "../../utils/reveal";

  whenReady(() => {
    document.querySelectorAll<HTMLElement>("[data-page-hero]").forEach((el) => {
      const scope = el.dataset.pageHero;
      if (scope) revealHero(scope);
    });
  });
</script>
