---
/**
 * SectionHeading.astro
 *
 * Encabezado de sección: `<h2>` + divisor + párrafo descriptivo. Extrae
 * el patrón que compartían WhatSetsUsApart y WereHere para que ambos
 * bloques mantengan el mismo ritmo visual sin duplicar clases.
 *
 * No envuelve el contenido en un contenedor extra: renderiza los tres
 * elementos como hermanos, igual que el markup original. Los tres
 * conservan `data-reveal` para que el script de la sección los anime.
 *
 * Alineación (`align`): "left" | "center" | "right", default "center"
 * para no alterar los usos existentes. El texto y la caja se mueven
 * juntos: el `<h2>` y el `<p>` cambian `text-*`, y el divisor + párrafo
 * cambian su margen automático (`mr-auto` / `mx-auto` / `ml-auto`).
 * Esos márgenes son mutuamente excluyentes por construcción; si se
 * concatenaran dos, ganaría el que Tailwind emita al final, no el orden
 * de la cadena.
 *
 * Las clases de alineación viven en un mapa con strings literales
 * porque Tailwind no detecta nombres construidos (`text-${align}`).
 *
 * Props:
 *   - id:      obligatorio, id del `<h2>` (también lo usa el
 *              `aria-labelledby` de la `<section>`).
 *   - class:   clases extra para el `<h2>`.
 *   - divider: si es `false`, omite el divisor (default `true`).
 *   - align:   alineación del bloque (default `"center"`).
 *
 * Slots:
 *   - default:     contenido del título.
 *   - description: contenido del párrafo descriptivo.
 */
import SectionDivider from "./SectionDivider.astro";

type Align = "left" | "center" | "right";

interface Props {
  id: string;
  class?: string;
  divider?: boolean;
  align?: Align;
}

const {
  id,
  class: className = "",
  divider = true,
  align = "center",
} = Astro.props;

/**
 * `text`: alineación del texto (título y descripción).
 * `block`: margen automático que pega el bloque al lado elegido. El
 * divisor y el párrafo tienen ancho máximo propio, así que sin este
 * margen se quedarían pegados a la izquierda aunque el texto esté
 * centrado o a la derecha.
 */
const ALIGN: Record<Align, { text: string; block: string }> = {
  left: { text: "text-left", block: "mr-auto" },
  center: { text: "text-center", block: "mx-auto" },
  right: { text: "text-right", block: "ml-auto" },
};

const alignment = ALIGN[align];

const headingClasses = ["heading-2 text-secondary", alignment.text, className]
  .filter(Boolean)
  .join(" ");

const descriptionClasses = [
  "paragraph-md mt-4 max-w-4xl text-balance text-secondary",
  alignment.text,
  alignment.block,
]
  .filter(Boolean)
  .join(" ");
---

<h2 id={id} class={headingClasses} data-reveal>
  <slot />
</h2>
{
  divider && (
    <SectionDivider class={`mt-2 sm:w-36 ${alignment.block}`} />
  )
}
{
  Astro.slots.has("description") && (
    <p class={descriptionClasses} data-reveal>
      <slot name="description" />
    </p>
  )
}
