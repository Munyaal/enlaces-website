---

import leadHeroBg from "../../assets/images/home/internet-hogar-riviera-maya.jpg";
import PageHero from "../ui/PageHero.astro";
---

<PageHero
  scope="lead-hero"
  image={leadHeroBg}
  priority
  overlayClass="bg-secondary/50"
  descriptionClass="paragraph-md mx-auto mt-5 max-w-5xl text-pretty text-light/90"
>
  Regístrate en <span class="text-primary">nuestra dinámica</span>
  <Fragment slot="description">
    Completa tus datos para registrar tu participación en la dinámica de
    Enlaces Playa en la Riviera Maya. Es rápido y solo necesitamos unos
    datos para identificarte.
  </Fragment>
</PageHero>
