---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import internetHogarModem from "../../assets/images/internet-hogar/internet-hogar-enlaces-playa.png";
import Container from "../ui/Container.astro";
import SectionDivider from "../ui/SectionDivider.astro";
import { parseBoldSegments } from "../../utils/bold-text";

/**
 * Beneficios de `/internet-hogar`: a la izquierda el listado, a la
 * derecha el módem.
 *
 * Decisiones:
 *
 *   1. El copy se escribe como texto plano con marcadores `**...**` y se
 *      parte con `parseBoldSegments` (`src/utils/bold-text.ts`). Es la
 *      convención que ya usa `about/WhyChooseTabs.astro`: se evita
 *      `set:html`, el texto se escapa solo y quien edita el contenido no
 *      necesita aprender un formato nuevo.
 *   2. El listado es un `<ul>` real (con `role="list"` para que Safari no
 *      lo colapse) y no una pila de párrafos: son puntos equivalentes.
 *   3. El icono va en un círculo decorativo con el naranja de marca; el
 *      texto es el que comunica, así que el círculo lleva `aria-hidden`.
 *   4. El `id` es `why-chose-hogar` y no `our-commitment` porque esta
 *      página también renderiza `ReadyToGetwork`, que ya usa ese id y
 *      ese scope de reveal: repetirlo dejaría ids duplicados en el DOM.
 */
const beneficios = [
  {
    icon: "calendar-check",
    copy: "**11 años conectando hogares y negocios** con internet en la Riviera Maya.",
  },
  {
    icon: "tool",
    copy: "**Instalación de internet** en 1 o 2 días hábiles, **con técnicos locales.**",
  },
  {
    icon: "clock",
    copy: "**Soporte técnico de internet** con respuesta en menos de 2 horas.",
  },
  {
    icon: "file-text",
    copy: "Internet con **contrato flexible**, garantía de **velocidad** y **soluciones a la medida**.",
  },
] as const;
---

<section
  id="why-chose-hogar"
  aria-labelledby="why-chose-hogar-title"
  data-reveal-scope="why-chose-hogar"
  class="relative bg-surface-1"
>
  <Container>
    <h2
      id="why-chose-hogar-title"
      class="heading-2 text-balance text-secondary"
      data-reveal
    >
      ¿Por qué elegir{" "}<span class="text-primary">Enlaces Playa?</span>
    </h2>
    <SectionDivider class="mt-2 sm:w-36 ml-0" />
    <div class="mt-8 grid items-start gap-10 md:mt-10 md:gap-12 lg:grid-cols-2 xl:gap-16">
      <ul role="list" class="space-y-5 md:space-y-6">
        {
          beneficios.map((beneficio) => (
            <li class="flex items-start gap-4" data-reveal>
              <span
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-light"
                aria-hidden="true"
              >
                <Icon name={beneficio.icon} class="h-6 w-6" />
              </span>
              <p class="paragraph-md text-secondary">
                {parseBoldSegments(beneficio.copy).map((segmento) =>
                  segmento.bold ? (
                    <strong class="font-bold">{segmento.text}</strong>
                  ) : (
                    segmento.text
                  ),
                )}
              </p>
            </li>
          ))
        }
      </ul>

      <div class="flex justify-center" data-reveal>
        <Image
          src={internetHogarModem}
          alt="Módem con señal Wi-Fi y el logotipo de Enlaces Playa"
          layout="constrained"
          widths={[320, 420, 540]}
          sizes="(min-width: 1024px) 36vw, (min-width: 768px) 50vw, 90vw"
          loading="lazy"
          decoding="async"
          class="h-auto w-full max-w-md object-contain lg:max-w-lg"
        />
      </div>
    </div>
  </Container>
</section>

<script>
  import { revealSection } from "../../utils/reveal";

  revealSection("why-chose-hogar");
</script>
