---
import SectionDivider from "../ui/SectionDivider.astro";
import internetHogar from "../../assets/images/internet-hogar/internet-hogar-enlaces-playa-contrata.png";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { whatsappLink } from "../../utils/constants";
import { Image } from "astro:assets";

---

<section
  id="our-commitment"
  aria-labelledby="our-commitment-title"
  data-reveal-scope="our-commitment"
  class="relative bg-surface-1"
>
  <Container>
    <div class="grid items-center gap-10 md:gap-12 lg:grid-cols-12 xl:gap-16">
      <div class="lg:col-span-7 space-y-6">
        <h2
          id="our-commitment-title"
          class="heading-2 text-balance text-secondary"
          data-reveal
        >
          ¿Listo para <span class="text-primary">contratar Internet</span> en la <span
            class="text-primary">Riviera Maya?</span
          >
        </h2>

        <SectionDivider class="mt-2 sm:w-36" />

        <p class="paragraph-md text-secondary/80" data-reveal>
          Encuentra el plan de Internet ideal para tu hogar y disfrutar una
          conexión rápida y estable, con cobertura y soporte técnico local.
        </p>

        <Button
          as="a"
          href={whatsappLink}
          size="lg"
          icon="brand-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          Escríbenos por Whatsapp
        </Button>
      </div>

      <div class="flex justify-center lg:col-span-5" data-reveal>
        <Image
          src={internetHogar}
          alt="Representante de Enlaces Playa con uniforme de la empresa"
          layout="constrained"
          widths={[320, 420, 540]}
          sizes="(min-width: 1024px) 36vw, (min-width: 768px) 50vw, 90vw"
          loading="lazy"
          decoding="async"
          class="h-auto w-full max-w-md object-contain lg:max-w-lg"
        />
      </div>
    </div>
  </Container>
</section>

<script>
  import { revealSection } from "../../utils/reveal";

  revealSection("our-commitment");
</script>
