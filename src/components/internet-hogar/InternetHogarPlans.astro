---
import PlanPriceCard from "./PlanPriceCard.astro";
import {
  TECNOLOGIAS,
  type PlanTechnology,
} from "../../data/internet-hogar/plans";

/** Icono que ilustra cada tecnología. */
const ICONOS: Record<PlanTechnology, string> = {
  fibra: "wifi",
  inalambrico: "broadcast-tower",
};
---

<section
  id="internet-hogar-plans"
  aria-label="Planes de Internet para hogar"
  data-reveal-scope="internet-hogar-plans"
>
  <div class="mx-auto w-full max-w-5xl px-6 py-10 lg:py-16">
    <div class="mt-10 flex justify-center">
      <div
        role="tablist"
        aria-label="Tecnología de Internet para hogar"
        class="inline-flex w-auto max-w-md flex-nowrap justify-center overflow-hidden rounded-full bg-secondary shadow-lg sm:max-w-lg"
      >
        {
          TECNOLOGIAS.map((tecnologia, index) => (
            <button
              id={`tab-${tecnologia.id}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`panel-${tecnologia.id}`}
              data-tecnologia={tecnologia.id}
              tabindex={index === 0 ? 0 : -1}
              class="min-h-11 flex-1 cursor-pointer rounded-full bg-secondary px-5 py-2.5 text-lg font-semibold text-light transition-colors duration-200 hover:bg-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset focus-visible:ring-offset-0 aria-selected:bg-primary aria-selected:shadow-md"
            >
              {tecnologia.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      TECNOLOGIAS.map((tecnologia, index) => (
        <div
          id={`panel-${tecnologia.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tecnologia.id}`}
          hidden={index !== 0}
          tabindex={0}
          class="mt-14 md:mt-20"
        >
          <div class="mt-8 grid items-stretch gap-6 sm:grid-cols-2 sm:gap-5 lg:grid-cols-3 lg:gap-6">
            {tecnologia.planes.map((plan) => (
              <PlanPriceCard
                plan={plan}
                icon={ICONOS[tecnologia.id]}
                destacado={plan.destacado ?? false}
                reveal
              />
            ))}
          </div>
        </div>
      ))
    }

    <div class="border-2 border-accent rounded-full p-4 mt-14 max-w-max mx-auto font-medium">
      El precio pronto pago aplica para los primeros 5 días a partir de tu fecha
      de contratación
    </div>
  </div>
</section>

<script>
  import {
    countMegasIn,
    revealNow,
    revealSection,
    whenReady,
  } from "../../utils/reveal";
  import { emitirPlanTecnologia } from "../../utils/plan-technology";
  import type { PlanTechnology } from "../../data/internet-hogar/plans";
  import { gsap } from "gsap";

  const pulseIcon = (element: HTMLElement) => {
    gsap.fromTo(
      element,
      { scale: 1 },
      {
        scale: 1.25,
        duration: 0.25,
        ease: "power2.out",
        yoyo: true,
        repeat: 1,
        clearProps: "transform",
      },
    );
  };

  const init = () => {
    revealSection("internet-hogar-plans", "list");

    const section = document.getElementById("internet-hogar-plans");
    if (!section) return;

    const tablist = section.querySelector<HTMLElement>("[role='tablist']");
    if (!tablist || tablist.dataset.tabsReady === "true") return;
    tablist.dataset.tabsReady = "true";

    const tabs = Array.from(
      tablist.querySelectorAll<HTMLButtonElement>("[role='tab']"),
    );

    // Los paneles se resuelven una sola vez (`aria-controls` -> panel)
    // para no consultar el DOM en cada activación.
    const panels = new Map<string, HTMLElement>();
    section
      .querySelectorAll<HTMLElement>("[role='tabpanel']")
      .forEach((panel) => panels.set(panel.id, panel));

    /**
     * Anima los contadores de megas de un panel.
     *
     * El conteo (duración, stagger, guarda `data-counted` y pop del
     * número) vive en `countMegasIn` porque la guía de elección
     * (`InternetHogarPlanGuide`) usa la misma animación. Aquí sólo se
     * añade el pulso del ícono al terminar cada número.
     */
    const animateCounters = (panel: HTMLElement) => {
      countMegasIn(panel, {
        onCountComplete: (counter) => {
          const icon = counter
            .closest("article")
            ?.querySelector<HTMLElement>("[data-plan-icon]");

          if (icon) pulseIcon(icon);
        },
      });
    };

    const showPanel = (panel: HTMLElement) => {
      const cards = Array.from(
        panel.querySelectorAll<HTMLElement>("[data-reveal]"),
      );
      revealNow(cards);
      animateCounters(panel);
    };

    const activateTab = (selectedTab: HTMLButtonElement, focus = false) => {
      tabs.forEach((tab) => {
        const isSelected = tab === selectedTab;
        tab.setAttribute("aria-selected", String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;

        const panel = panels.get(tab.getAttribute("aria-controls") ?? "");
        if (!panel) return;

        panel.hidden = !isSelected;
        if (isSelected) showPanel(panel);
      });

      const tecnologia = selectedTab.dataset.tecnologia as
        | PlanTechnology
        | undefined;
      if (tecnologia) emitirPlanTecnologia(tecnologia);

      if (focus) selectedTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateTab(tab));

      tab.addEventListener("keydown", (event) => {
        let nextIndex: number;

        switch (event.key) {
          case "ArrowRight":
            nextIndex = (index + 1) % tabs.length;
            break;
          case "ArrowLeft":
            nextIndex = (index - 1 + tabs.length) % tabs.length;
            break;
          case "Home":
            nextIndex = 0;
            break;
          case "End":
            nextIndex = tabs.length - 1;
            break;
          default:
            return;
        }

        event.preventDefault();
        activateTab(tabs[nextIndex], true);
      });
    });

    const firstPanel = panels.get(tabs[0]?.getAttribute("aria-controls") ?? "");
    if (firstPanel) animateCounters(firstPanel);
  };

  whenReady(init);
</script>
