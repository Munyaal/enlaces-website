---
import { Icon } from "astro-icon/components";
import CTAButton from "../ui/CTAButton.astro";
import type { HogarPlan } from "../../data/internet-hogar/plans";
import { PLAN_CTA } from "../../data/internet-hogar/plans";

interface Props {
  plan: HogarPlan;
  /** Icono que ilustra la tecnología (`wifi` / `broadcast-tower`). */
  icon: string;
  /** `true` cuando el plan es el destacado de su tecnología. */
  destacado?: boolean;
  /** Permite identificar la tarjeta desde el script de la sección. */
  reveal?: boolean;
}

const { plan, icon, destacado = false, reveal = false } = Astro.props;

const cardClasses = [
  "relative flex w-full flex-col rounded-3xl p-5 pt-8 text-center shadow-2xl sm:p-6 sm:pt-9",
  destacado
    ? "bg-secondary text-light"
    : "border border-line bg-light text-secondary",
];

const megasClasses = [
  "font-display text-[4rem] leading-none font-bold sm:text-[6rem]",
  destacado ? "text-light" : "text-secondary",
];

const megasLabelClasses = [
  "paragraph-xs font-bold uppercase tracking-[0.2em]",
  destacado ? "text-light/80" : "text-secondary/80",
];

const priceBoxClasses = [
  "mt-4 rounded-2xl px-4 py-4",
  destacado ? "bg-light/10" : "bg-line/50",
];

const priceLabelClasses = [
  "paragraph-sm font-semibold",
  destacado ? "text-light/90" : "text-secondary",
];

const priceValueClasses = [
  "mt-1 font-display text-[2.5rem] leading-none font-bold sm:text-[3rem]",
  destacado ? "text-light" : "text-dark",
];

const regularClasses = [
  "paragraph-xs mt-3 line-through",
  destacado ? "text-light/70" : "text-secondary/70",
];

const installClasses = [
  "paragraph-md mt-3 font-semibold",
  destacado ? "text-light" : "text-secondary",
];

const badgeClasses = [
  "absolute -top-4 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full px-4 py-1.5",
  destacado ? "bg-primary" : "bg-secondary",
];

const badgeNameClasses = destacado ? "font-bold" : "text-primary font-bold";
---

<article class:list={cardClasses} data-reveal={reveal ? "" : undefined}>
  <p
    class:list={[
      badgeClasses,
      "paragraph-xs font-medium uppercase tracking-[0.18em]",
    ]}
  >
    <span class="text-white">{plan.etiqueta}</span>
    <span class={badgeNameClasses}> {plan.nombre}</span>
  </p>

  <div
    class="mx-auto flex items-center justify-center text-primary mb-4"
    aria-hidden="true"
    data-plan-icon={destacado ? "" : undefined}
  >
    <Icon name={icon} class="h-10 w-10" />
  </div>

  {/* Valor accesible (no se anima) + número animado (aria-hidden). */}
  <span class="sr-only">{plan.megas} megas</span>

  <p class:list={megasClasses}>
    <span aria-hidden="true" data-megas-count data-megas-value={plan.megas}>
      {plan.megas}
    </span>
  </p>

  <p class:list={megasLabelClasses}>Megas</p>

  <div class:list={priceBoxClasses}>
    <p class:list={priceLabelClasses}>Pronto Pago</p>
    <p class:list={priceValueClasses}>{plan.prontoPago}</p>
    <hr
      aria-hidden="true"
      class="mx-auto mt-3 h-0.5 w-16 border-0 bg-accent-grad-radial"
    />
    <p class:list={regularClasses}>
      Precio Regular <s>{plan.precioRegular}</s>
    </p>
  </div>

  <p class:list={installClasses}>Instalación {plan.instalacion}</p>

  <div class="mt-4 md:mt-auto md:pt-4">
    <CTAButton as="a" href={PLAN_CTA.href} variant="orange" size="sm">
      {PLAN_CTA.label}
    </CTAButton>
  </div>
</article>
