---
/**
 * EmpresasSectors.astro
 *
 * Sección "Sectores que conectamos en la Riviera Maya" de `/internet-empresas`:
 * encabezado centrado con descripción, rejilla 2×2 de tarjetas por sector y
 * un CTA de WhatsApp al pie.
 *
 * Decisiones:
 *
 *   1. Las tarjetas se alimentan de `SECTORES` (`src/data/internet-empresas/
 *      sectores.ts`): el componente es sólo presentación y el copy + las
 *      imágenes se editan en el dato.
 *   2. La imagen va arriba a su proporción natural (3:2): los PNG ya traen
 *      las esquinas redondeadas como transparencia, así que forzar un
 *      `aspect-*` + `object-cover` las recortaría. No hay borde, fondo ni
 *      sombra en la tarjeta; el titular y la descripción van centrados.
 *   3. El CTA repite el patrón de `EmpresasSolution`: `Button` con
 *      `brand-whatsapp`, apuntando a `SITE.whatsapp`.
 */
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import { SITE } from "../../data/site";
import { SECTORES } from "../../data/internet-empresas/sectores";
---

<section
  id="empresas-sectors"
  aria-labelledby="empresas-sectors-title"
  data-reveal-scope="empresas-sectors"
  class="bg-light"
>
  <Container>
    <SectionHeading id="empresas-sectors-title">
      Sectores que conectamos{" "}
      <span class="text-primary-on-light">en la Riviera Maya</span>
      <Fragment slot="description">
        En {" "}<span class="font-bold">Enlaces Playa</span>{" "} ofrecemos soluciones
        de {" "}<span class="font-bold"
          >internet empresarial para distintos sectores,</span
        >{" "} conociendo las necesidades de conectividad de{" "}<span
          class="font-bold"
        >
          hoteles, inmobiliarias, oficinas y negocios de la región.
        </span>
      </Fragment>
    </SectionHeading>

    <div class="mt-16 grid gap-x-8 gap-y-14 sm:grid-cols-2 md:mt-24 md:gap-x-12 md:gap-y-20">
      {
        SECTORES.map((sector) => (
          <article class="flex flex-col items-center text-center" data-reveal>
            <Image
              src={sector.imagen}
              alt={sector.alt}
              layout="constrained"
              widths={[320, 480, 640, 722]}
              sizes="(min-width: 640px) 50vw, 100vw"
              loading="lazy"
              decoding="async"
              class="h-auto w-full"
            />
            <h3 class="heading-6 mt-6 text-secondary">{sector.titulo}</h3>
            <p class="paragraph-sm mt-3 text-secondary/80">
              {sector.descripcion}
            </p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex justify-center md:mt-12" data-reveal>
      <Button
        as="a"
        href={SITE.whatsapp}
        size="lg"
        icon="brand-whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        Cotiza por Whatsapp
      </Button>
    </div>
  </Container>
</section>

<script>
  import { revealSection } from "../../utils/reveal";

  revealSection("empresas-sectors", "list");
</script>
