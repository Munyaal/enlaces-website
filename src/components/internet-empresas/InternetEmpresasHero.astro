---
/**
 * Hero de /internet-empresas.
 *
 * Delega en `PageHero` el layout, el overlay, el divisor y el reveal para
 * no duplicar el `<header>` que ya usan las demás páginas internas.
 */
import fondoEmpresas from "../../assets/images/internet-empresas/internet-empresas-enlaces-playa.jpg";
import PageHero from "../ui/PageHero.astro";
---

<PageHero
  scope="internet-empresas-hero"
  image={fondoEmpresas}
  priority
  overlayClass="bg-secondary/50"
  descriptionClass="paragraph-md mx-auto mt-5 max-w-5xl text-pretty text-light/90"
>
  <span class="text-primary">Internet</span>{" "}para empresas en la {" "}
  <span class="text-primary">Riviera Maya</span>

  <Fragment slot="description">
    Impulsa tu negocio con soluciones de internet empresarial en la Riviera
    Maya. En Enlaces Playa conectamos hoteles, inmobiliarias y empresas con
    servicios de internet diseñados para mantener sus operaciones, sistemas y
    equipos conectados, con soporte técnico local y cobertura en Playa del
    Carmen, Tulum y Puerto Morelos.
  </Fragment>
</PageHero>
