---
/**
 * Hero de /nosotros.
 *
 * Delega en `PageHero` el layout, el overlay, el divisor y el reveal para
 * no duplicar el `<header>` que ya usan las demás páginas internas.
 */
import internetEmpresas from "../../assets/images/about/internet-empresas-enlaces-playa.jpg";
import PageHero from "../ui/PageHero.astro";
---

<PageHero
  scope="about-hero"
  image={internetEmpresas}
  priority
  overlayClass="bg-secondary/50"
  descriptionClass="paragraph-md mx-auto mt-5 max-w-5xl text-pretty text-light/90"
>
  Conectamos <span class="text-primary"
    >la Riviera Maya con internet para</span
  > hogares y empresas
  <Fragment slot="description">
    En Enlaces Playa llevamos 11 años ofreciendo internet para hogares y
    empresas en la Riviera Maya, con soporte técnico local y soluciones para
    cada necesidad en Playa del Carmen, Tulum y Puerto Morelos.
  </Fragment>
</PageHero>
