---
import { Image } from "astro:assets";
import quienesSomosEnlaces from "../../assets/images/about/porque-elegir-enlaces-playa.png";
---

<section aria-labelledby="why-choose-title">
  <div class="mx-auto w-full max-w-7xl px-6 lg:pt-16">
    <div class="grid gap-10 md:gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
      <div>
        <h2
          id="why-choose-title"
          class="heading-2 mt-5 sm:mt-6 text-secondary text-left"
          data-reveal
        >
          ¿Por qué elegir{" "}<span class="text-primary-on-light"
            >Enlaces Playa?</span
          >
        </h2>
        <hr
          aria-hidden="true"
          class="mx-auto lg:ml-0 mt-4 h-1 w-32 border-0 bg-accent-grad-radial sm:w-52"
          data-reveal
        />
      </div>

      <div class="flex items-center justify-center" data-reveal>
        <Image
          src={quienesSomosEnlaces}
          alt="Internet en la Riviera Maya"
          loading="lazy"
          decoding="async"
          class="w-full max-w-lg rounded-2xl object-cover sm:max-w-xl"
        />
      </div>
    </div>
  </div>
</section>
