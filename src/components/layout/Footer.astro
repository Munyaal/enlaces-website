---
import HyperlinksSection from "./HyperlinksSection.astro";
import enlacesLogo from "../../assets/images/brand/enlaces-logo-letras-blancas.png";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import { Image } from "astro:assets";
import CustomerServiceHyperlinks from "./CustomerServiceHyperlinks.astro";
import { SITE } from "../../data/site";
import { NAV_URLS } from "../../data/navigation";
import {
  COBERTURA_LINKS,
  INTERNET_LINKS,
  LEGAL_LINKS,
  PORTAL_CLIENTE,
  RECURSOS_LINKS,
  TAGLINE,
} from "../../data/footer";

// Copyright dinámico: se evalúa en build, así queda congelado al año de
// generación del sitio sin perder la convención dinámica del proyecto.
const year = new Date().getFullYear();
---

<footer class="bg-secondary text-light">
  <Container>
    <!-- ─────────────────────────────────────────────────────────────
     * Franja 1 — Cuerpo principal
     * Cuadrícula: 1 col mobile, 2 cols tablet, 4 cols desktop.
     * ───────────────────────────────────────────────────────────── -->
    <div class="grid gap-6 sm:grid-cols-2 sm:gap-10 lg:grid-cols-4 lg:gap-10">
      <!-- Columna 1 — Marca -->
      <div class="space-y-6">
        <a
          href={NAV_URLS.home}
          aria-label="Ir al inicio de Enlaces Playa"
          class="block mx-auto"
        >
          <Image
            src={enlacesLogo}
            alt="Logo Enlaces Playa"
            class="h-20 w-auto lg:h-24"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="paragraph-xs leading-relaxed text-light/80">
          {TAGLINE}
        </p>
        <div>
          <Button as="a" href={NAV_URLS.aboutUs} variant="navy" size="sm">
            Conoce Enlaces Playa
          </Button>
        </div>
      </div>

      <!-- Columna 2 — Internet -->
      <nav class="space-y-4">
        <HyperlinksSection
          sectionName="Internet"
          sectionIcon="wifi"
          links={INTERNET_LINKS}
        />
      </nav>

      <!-- Columna 3 — Cobertura + Recursos -->
      <div class="space-y-4">
        <HyperlinksSection
          sectionName="Cobertura"
          sectionIcon="broadcast-tower"
          links={COBERTURA_LINKS}
        />
        <HyperlinksSection
          sectionName="Recursos"
          sectionIcon="chart-pie"
          links={RECURSOS_LINKS}
        />
      </div>

      <!-- Columna 4 — Atención a clientes -->
      <div>
        <CustomerServiceHyperlinks />
      </div>
    </div>

    <!-- ─────────────────────────────────────────────────────────────
     * Franja 2 — Portal de Cliente
     * ───────────────────────────────────────────────────────────── -->
    <hr class="mt-10 text-light/20" />
    <div
      class="flex flex-col justify-center items-center text-center gap-3 md:flex-row md:gap-6 py-5"
    >
      <p class="paragraph-xs text-light/90">
        {PORTAL_CLIENTE.copy}
      </p>
      <Button
        as="a"
        href={PORTAL_CLIENTE.href}
        variant="navy"
        target="_blank"
        icon="user"
        size="sm"
      >
        {PORTAL_CLIENTE.label}
      </Button>
    </div>
    <hr class="mb-5 text-light/20" />

    <!-- ─────────────────────────────────────────────────────────────
     * Franja 3 — Legal
     * ───────────────────────────────────────────────────────────── -->
    <div class="flex flex-col justify-center items-center text-center gap-3">
      <p class="text-xs text-accent">
        © {year} Enlaces Playa · Todos los derechos reservados.{" "}
        {
          LEGAL_LINKS.map((link, idx) => (
            <Fragment>
              <a
                href={link.href}
                class="transition-colors hover:text-light focus-visible:outline-none focus-visible:underline"
              >
                {link.text}
              </a>
              {idx < LEGAL_LINKS.length - 1 && (
                <span aria-hidden="true"> · </span>
              )}
            </Fragment>
          ))
        }
      </p>
      <address class="text-xs text-accent">
        {SITE.direccion}
      </address>
    </div>
  </Container>
</footer>
