---
import HyperlinksSection from "./HyperlinksSection.astro";
import enlacesLogo from "./../../assets/images/logos/enlaces-logo-letras-blancas.png";
import Container from "../Container.astro";
import Button from "../ui/Button.astro";
import { Image } from "astro:assets";
import CustomerServiceHyperlinks from "./CustomerServiceHyperlinks.astro";

// Tagline aprobada: posicionamiento del sitio.
const TAGLINE =
  "Internet rápido y estable para hogares y empresas en la Riviera Maya, con cobertura local y soporte técnico cercano.";

// Columna Internet — cuatro enlaces principales de producto.
const internet = [
  { href: "#", text: "Internet para Hogar" },
  { href: "#", text: "Planes de Internet" },
  { href: "#", text: "Fibra Óptica" },
  { href: "#", text: "Internet Inalámbrico" },
];

// Columna Cobertura — tres enlaces de zona.
const cobertura = [
  { href: "#", text: "Cobertura de Internet" },
  { href: "#", text: "Cobertura de Playa del Carmen" },
  { href: "#", text: "Cobertura de Puerto Morelos" },
];

// Sub-bloque Recursos — tres enlaces de soporte y contenido.
const recursos = [
  { href: "#", text: "Blog" },
  { href: "#", text: "Preguntas frecuentes" },
  { href: "#", text: "Soporte técnico" },
];

// Franja Portal de Cliente — copy y CTA outline.
const portalCliente = {
  copy: "¿YA ERES CLIENTE? Consulta y paga tu servicio desde tu Portal de Cliente.",
  href: "https://portal.enlacesplaya.com.mx/cliente/login",
  label: "Iniciar sesión",
};

// Franja legal — enlaces a documentos y domicilio corporativo.
const legalLinks = [
  { href: "#", text: "Términos y Condiciones" },
  { href: "#", text: "Aviso de Privacidad" },
];

const direccion =
  "Enlaces Playa, una empresa de Grupo Webtel, Calle 72 entre Av. Sian Ka'an y Carr. Federal, Mza. 026, Lote 0, Col. Ejidal, C.P. 77714, Playa del Carmen, Q. Roo.";

// Copyright dinámico: se evalúa en build, así queda congelado al año de
// generación del sitio sin perder la convención dinámica del proyecto.
const year = new Date().getFullYear();
---

<footer class="bg-secondary text-light">
  <Container>
    <!-- ─────────────────────────────────────────────────────────────
     * Franja 1 — Cuerpo principal
     * Cuadrícula: 1 col mobile, 2 cols tablet, 4 cols desktop.
     * ───────────────────────────────────────────────────────────── -->
    <div class="grid gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-4 lg:gap-10">
      <!-- Columna 1 — Marca -->
      <div class="flex flex-col gap-4">
        <a
          href="#"
          aria-label="Ir al inicio de Enlaces Playa"
          class="block mx-auto"
        >
          <Image
            src={enlacesLogo}
            alt="Logo Enlaces Playa"
            class="h-20 w-auto lg:h-24"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-sm leading-relaxed text-light/80">
          {TAGLINE}
        </p>
        <Button as="a" href="#" variant="navy"> Conoce Enlaces Playa </Button>
      </div>

      <!-- Columna 2 — Internet -->
      <nav class="space-y-4">
        <HyperlinksSection
          sectionName="Internet"
          sectionIcon="wifi"
          links={internet}
        />
      </nav>

      <!-- Columna 3 — Cobertura + Recursos -->
      <div class="space-y-4">
        <HyperlinksSection
          sectionName="Cobertura"
          sectionIcon="broadcast-tower"
          links={cobertura}
        />
        <HyperlinksSection
          sectionName="Recursos"
          sectionIcon="chart-pie"
          links={recursos}
        />
      </div>

      <!-- Columna 4 — Atención a clientes -->
      <div>
        <CustomerServiceHyperlinks />
      </div>
    </div>

    <!-- ─────────────────────────────────────────────────────────────
     * Franja 2 — Portal de Cliente
     * ───────────────────────────────────────────────────────────── -->
    <hr class="mt-10 text-light/20" />
    <div
      class="flex flex-col justify-center items-center text-center gap-3 md:flex-row md:gap-6 py-5"
    >
      <p class="text-sm text-light/90 md:text-base">
        {portalCliente.copy}
      </p>
      <Button
        as="a"
        href={portalCliente.href}
        variant="navy"
        target="_blank"
        icon="user"
      >
        {portalCliente.label}
      </Button>
    </div>
    <hr class="mb-5 text-light/20" />

    <!-- ─────────────────────────────────────────────────────────────
     * Franja 3 — Legal
     * ───────────────────────────────────────────────────────────── -->
    <div class="flex flex-col justify-center items-center text-center gap-3">
      <p class="text-xs text-light/90">
        © {year} Enlaces Playa · Todos los derechos reservados.{" "}
        {
          legalLinks.map((link, idx) => (
            <Fragment>
              <a
                href={link.href}
                class="transition-colors hover:text-light focus-visible:outline-none focus-visible:underline"
              >
                {link.text}
              </a>
              {idx < legalLinks.length - 1 && (
                <span aria-hidden="true"> · </span>
              )}
            </Fragment>
          ))
        }
      </p>
      <address class="text-xs text-light/90">
        {direccion}
      </address>
    </div>
  </Container>
</footer>
