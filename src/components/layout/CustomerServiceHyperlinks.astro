---
/**
 * Canales de atención de la columna 4 del footer.
 *
 * El contenido vive en `src/data/site.ts` (`CANALES`) porque los mismos
 * teléfonos se usan en otras partes del sitio y no deben divergir. Aquí solo
 * se decide la presentación: un rótulo opcional encima del valor y el enlace
 * accesible.
 *
 * El correo se renderiza con `label: null` porque el propio valor hace de
 * etiqueta, igual que en el diseño original.
 */
import { Icon } from "astro-icon/components";
import { CANALES, type CanalContacto } from "../../data/site";

const atencion = {
  title: "Atención a clientes",
  intro: "¿Necesitas ayuda? Estamos para atenderte",
};

/** Etiqueta accesible: la acción cambia según el esquema del enlace. */
const ariaLabel = (canal: CanalContacto): string =>
  canal.kind === "tel"
    ? `Llamar a ${canal.label ?? canal.value}: ${canal.value}`
    : `Enviar correo a ${canal.value}`;
---

<nav class="space-y-1" aria-label={atencion.title}>
  <div class="flex items-baseline gap-2">
    <Icon name="user" class="w-5 h-5 text-primary" />
    <h3 class="paragraph-sm font-bold text-accent">{atencion.title}</h3>
  </div>

  <p class="paragraph-xs leading-relaxed text-light/80">
    {atencion.intro}
  </p>

  {
    CANALES.map((canal) => (
      <div>
        {canal.label && (
          <p class="paragraph-xs text-light/70">{canal.label}</p>
        )}
        <a
          href={canal.href}
          aria-label={ariaLabel(canal)}
          class="paragraph-xs font-semibold text-accent/80 transition-colors hover:text-accent focus-visible:outline-none focus-visible:underline"
        >
          {canal.value}
        </a>
      </div>
    ))
  }
</nav>
