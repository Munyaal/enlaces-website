---
type Props = {
  title: string;
  subtitle?: string;
};
const { title, subtitle} = Astro.props;
---
<div>
<a
  href=""
  class="flex flex-col items-center text-center rounded-full bg-accent bg-accent-grad-t font-bold px-8 md:py-1"
>
  <span class="text-light text-xl">{subtitle}</span>
  <span class="text-light text-2xl lg:text-3xl">{title}</span>
</a>

</div>