---
import Container from "./Container.astro";
/**
 * Footer.astro
 *
 * Pie de página principal del sitio. Se renderiza desde
 * `src/layouts/Layout.astro` y aparece en todas las páginas.
 *
 * Estructura visual compacta (apilada en móvil, 2 columnas en sm,
 * grid horizontal de 12 columnas en lg):
 *   - Marca + Contáctanos (lg:col-span-3)
 *   - Servicios (lg:col-span-2)
 *   - Empresa (lg:col-span-2)
 *   - Cobertura (lg:col-span-2)
 *   - Síguenos (solo iconos) + Portal de Cliente (botón compacto)
 *     (lg:col-span-3)
 *
 * El bloque de copyright + enlaces legales vive debajo, separado por
 * un `hr` sutil.
 *
 * Toda la información vive como constantes declaradas arriba del
 * template para mantener el marcado declarativo y concentrar los
 * cambios de contenido en un solo lugar.
 *
 * Notas de iconografía:
 *  - Los íconos de redes sociales se renderizan con `astro-icon` a
 *    partir de los SVG locales en `src/icons/` (Tabler Icons).
 *  - El carácter Unicode `↗` (U+2197) sigue siendo el indicador
 *    textual del botón del portal, tal como pide la spec.
 *  - Las redes sociales se muestran ahora como botones circulares
 *    con sólo el ícono (etiqueta accesible vía `aria-label`) para
 *    mantener el footer bajo y limpio.
 */

import { Icon } from "astro-icon/components";

const servicios = [
  { href: "#", text: "Internet para hogar" },
  { href: "#", text: "Internet para empresas" },
  { href: "/cobertura", text: "Coberturas" },
  { href: "/blog", text: "Blog" },
  { href: "#", text: "Preguntas frecuentes" },
];

const empresa = [
  { href: "/aboutUs", text: "Nuestra historia" },
  { href: "#", text: "Términos y condiciones" },
  { href: "#", text: "Política de Uso Justo" },
  { href: "#", text: "Aviso de privacidad" },
];

const cobertura = [
  { href: "/cobertura/playa-del-carmen", text: "Playa del Carmen" },
  { href: "/cobertura/puerto-morelos", text: "Puerto Morelos" },
  { href: "/cobertura/tulum", text: "Tulum" },
];

const redesSociales = [
  { href: "#", label: "Facebook", icon: "brand-facebook" },
  { href: "#", label: "Instagram", icon: "brand-instagram" },
  { href: "#", label: "WhatsApp", icon: "brand-whatsapp" },
];

const portalCliente = {
  href: "#",
  ctaLabel: "Ir al Portal de Cliente",
};

// El Portal de Cliente ya tiene su propio botón compacto en la
// columna "Síguenos", así que no se duplica en los enlaces legales.
const legalLinks = [
  { href: "#", text: "Aviso de Privacidad", external: false },
  { href: "#", text: "Términos y Condiciones", external: false },
];

const year = 2026;
---

<footer class="bg-secondary text-light">
  <Container>
    {
      /* ──────────────────────────────────────────────────────────
        Sección única: marca, navegación, redes y portal
       ────────────────────────────────────────────────────────── */
    }
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      {/* Marca + Contáctanos */}
      <div class="sm:col-span-2 lg:col-span-3">
        <img
          src="/images/logo-enlaces-blanco.webp"
          alt="Logo Enlaces Playa"
          class="mb-4 h-12 w-auto lg:h-14"
          loading="lazy"
          decoding="async"
        />
        <h3 class="text-xs font-bold uppercase tracking-widest text-light">
          Contáctanos
        </h3>
        <address
          class="not-italic mt-3 space-y-2 text-sm leading-relaxed text-light/90"
        >
          <p>
            <a
              href="https://maps.app.goo.gl/g1xk8DjxTot7QoTr5"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Abrir ubicación de oficinas en Google Maps"
              class="transition-colors hover:text-light"
            >
              Oficinas en Playa del Carmen
            </a>
          </p>
          <p>
            <a
              href="mailto:hola@enlacesplaya.com.mx"
              class="transition-colors hover:text-light"
            >
              hola@enlacesplaya.com.mx
            </a>
          </p>
          <p>
            <a
              href="tel:+529841440714"
              class="transition-colors hover:text-light"
            >
              +52 (984) 144 0714
            </a>
          </p>
        </address>
      </div>

      {/* Servicios */}
      <nav aria-label="Servicios" class="lg:col-span-2">
        <h3 class="text-xs font-bold uppercase tracking-widest text-light">
          Servicios
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          {
            servicios.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-light/90 transition-colors hover:text-light"
                >
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Empresa */}
      <nav aria-label="Empresa" class="lg:col-span-2">
        <h3 class="text-xs font-bold uppercase tracking-widest text-light">
          Empresa
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          {
            empresa.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-light/90 transition-colors hover:text-light"
                >
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Cobertura */}
      <nav aria-label="Cobertura" class="lg:col-span-2">
        <h3 class="text-xs font-bold uppercase tracking-widest text-light">
          Cobertura
        </h3>
        <ul class="mt-3 space-y-2 text-sm">
          {
            cobertura.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-light/90 transition-colors hover:text-light"
                >
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Síguenos (solo iconos) + Portal de Cliente (botón compacto) */}
      <div class="lg:col-span-3">
        <h3 class="text-xs font-bold uppercase tracking-widest text-light">
          Síguenos
        </h3>
        <ul class="mt-3 flex gap-2">
          {
            redesSociales.map((red) => (
              <li>
                <a
                  href={red.href}
                  aria-label={red.label}
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-light/10 text-light transition-colors hover:bg-light/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light"
                >
                  <Icon
                    name={red.icon}
                    class="h-5 w-5 shrink-0"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ul>

        <h3 class="mt-6 text-xs font-bold uppercase tracking-widest text-light">
          Portal de Cliente
        </h3>
        <a
          href={portalCliente.href}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center gap-2 rounded-full bg-accent bg-accent-grad-t px-4 py-2 text-sm font-bold text-dark shadow-sm transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light"
        >
          <span>{portalCliente.ctaLabel}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    {/* Separador inferior */}
    <hr class="mt-8 border-light/20" />

    {/* Copyright + enlaces legales */}
    <div
      class="flex flex-col items-center gap-3 pt-6 text-center text-xs text-light/85 md:flex-row md:justify-between md:text-left"
    >
      <p>
        © {year} Enlaces Playa · Todos los derechos reservados.
        <span class="block md:inline">
          Enlaces Playa es una empresa del grupo Webtel.
        </span>
      </p>
      <ul
        class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 md:justify-end"
      >
        {
          legalLinks.map((link, idx) => (
            <li class="inline-flex items-center gap-x-3">
              <a
                href={link.href}
                class="transition-colors hover:text-light"
                {...(link.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
              >
                {link.text}
              </a>
              {idx < legalLinks.length - 1 && (
                <span aria-hidden="true" class="text-light/40">
                  ·
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
