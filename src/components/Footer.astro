---
import Container from "./Container.astro";
import HyperlinksSection from "./layouts/HyperlinksSection.astro";

// Tagline aprobada: posicionamiento del sitio.
const TAGLINE =
  "Internet rápido y estable para hogares y empresas en la Riviera Maya, con cobertura local y soporte técnico cercano.";

// Columna Internet — cuatro enlaces principales de producto.
const internet = [
  { href: "#", text: "Internet para Hogar" },
  { href: "#", text: "Planes de Internet" },
  { href: "#", text: "Fibra Óptica" },
  { href: "#", text: "Internet Inalámbrico" },
];

// Columna Cobertura — tres enlaces de zona.
const cobertura = [
  { href: "#", text: "Cobertura de Internet" },
  { href: "#", text: "Cobertura de Playa del Carmen" },
  { href: "#", text: "Cobertura de Puerto Morelos" },
];

// Sub-bloque Recursos — tres enlaces de soporte y contenido.
const recursos = [
  { href: "#", text: "Blog" },
  { href: "#", text: "Preguntas frecuentes" },
  { href: "#", text: "Soporte técnico" },
];

// Columna Atención a clientes — intro y cuatro canales de contacto.
// Los `href` apuntan a `#` por aprobación temporal; los textos visibles
// conservan el formato aprobado en el resto del sitio.
const atencion = {
  intro: "¿Necesitas ayuda? Estamos para atenderte",
  contactos: [
    {
      label: "Atención telefónica",
      value: "984 109 111",
      href: "#",
    },
    {
      label: "Atención a Clientes y Ventas Residenciales",
      value: "984 144 0714",
      href: "#",
    },
    {
      label: "Ventas Empresariales y PYME",
      value: "984 184 5726",
      href: "#",
    },
    {
      label: "Correo",
      value: "hola@enlacesplaya.com.mx",
      href: "#",
    },
  ],
};

// Franja Portal de Cliente — copy y CTA outline.
const portalCliente = {
  copy: "¿YA ERES CLIENTE? Consulta y paga tu servicio desde tu Portal de Cliente.",
  href: "#",
  label: "Iniciar sesión",
};

// Franja legal — enlaces a documentos y domicilio corporativo.
const legalLinks = [
  { href: "#", text: "Términos y Condiciones" },
  { href: "#", text: "Aviso de Privacidad" },
];

const direccion =
  "Enlaces Playa, una empresa de Grupo Webtel, Calle 72 entre Av. Sian Ka'an y Carr. Federal, Mza. 026, Lote 0, Col. Ejidal, C.P. 77714, Playa del Carmen, Q. Roo.";

// Copyright dinámico: se evalúa en build, así queda congelado al año de
// generación del sitio sin perder la convención dinámica del proyecto.
const year = new Date().getFullYear();
---

<footer class="bg-secondary text-light">
  <Container>
    <!-- ─────────────────────────────────────────────────────────────
     * Franja 1 — Cuerpo principal
     * Cuadrícula: 1 col mobile, 2 cols tablet, 4 cols desktop.
     * ───────────────────────────────────────────────────────────── -->
    <div class="grid gap-8 sm:grid-cols-2 sm:gap-10 lg:grid-cols-4 lg:gap-10">
      <!-- Columna 1 — Marca -->
      <div>
        <a
          href="#"
          aria-label="Ir al inicio de Enlaces Playa"
          class="inline-block"
        >
          <img
            src="/images/logo-enlaces-blanco.webp"
            alt="Logo Enlaces Playa"
            class="h-12 w-auto lg:h-14"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-light/85">
          {TAGLINE}
        </p>
        <a
          href="#"
          class="mt-5 inline-flex shrink-0 items-center justify-center rounded-full border border-light/40 px-6 py-2 text-sm font-semibold text-light transition-colors hover:border-light/70 hover:bg-light/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light"
        >
          Conoce Enlaces Playa
        </a>
      </div>

      <!-- Columna 2 — Internet -->
      <nav class="space-y-4">
        <HyperlinksSection
          sectionName="Internet"
          sectionIcon="wifi"
          links={internet}
        />
      </nav>

      <!-- Columna 3 — Cobertura + Recursos -->
      <div class="space-y-4">
        <HyperlinksSection
          sectionName="Cobertura"
          sectionIcon="broadcast-tower"
          links={cobertura}
        />
        <HyperlinksSection
          sectionName="Recursos"
          sectionIcon="chart-pie"
          links={recursos}
        />
      </div>

      <!-- Columna 4 — Atención a clientes -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-widest text-light">
          Atención a clientes
        </h3>
        <p class="mt-4 text-sm leading-relaxed text-light/85">
          {atencion.intro}
        </p>
        <ul class="mt-4 space-y-3 text-sm">
          {
            atencion.contactos.map((contacto) => (
              <li>
                <span class="block text-xs font-semibold uppercase tracking-wider text-light/70">
                  {contacto.label}
                </span>
                <a
                  href={contacto.href}
                  class="mt-0.5 inline-block text-light/90 transition-colors hover:text-light focus-visible:outline-none focus-visible:underline"
                >
                  {contacto.value}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- ─────────────────────────────────────────────────────────────
     * Franja 2 — Portal de Cliente
     * ───────────────────────────────────────────────────────────── -->
    <div
      class="mt-10 flex flex-col items-center gap-3 border-t border-light/10 pt-8 text-center md:flex-row md:justify-between md:gap-6 md:text-left"
    >
      <p class="text-sm text-light/90 md:text-base">
        {portalCliente.copy}
      </p>
      <a
        href={portalCliente.href}
        class="inline-flex shrink-0 items-center justify-center rounded-full border border-light/40 px-6 py-2 text-sm font-semibold text-light transition-colors hover:border-light/70 hover:bg-light/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light md:text-base"
      >
        {portalCliente.label}
      </a>
    </div>

    <!-- ─────────────────────────────────────────────────────────────
     * Franja 3 — Legal
     * ───────────────────────────────────────────────────────────── -->
    <hr class="mt-10 border-light/20" />

    <div
      class="flex flex-col items-center gap-3 pt-6 text-center text-xs text-light/80 md:flex-row md:justify-between md:gap-6 md:text-left"
    >
      <p>
        © {year} Enlaces Playa · Todos los derechos reservados.
      </p>
      <ul
        class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 md:justify-end"
      >
        {
          legalLinks.map((link, idx) => (
            <li class="inline-flex items-center gap-x-3">
              <a
                href={link.href}
                class="transition-colors hover:text-light focus-visible:outline-none focus-visible:underline"
              >
                {link.text}
              </a>
              {idx < legalLinks.length - 1 && (
                <span aria-hidden="true" class="text-light/40">
                  ·
                </span>
              )}
            </li>
          ))
        }
        <li class="inline-flex items-center gap-x-3 text-light/70">
          <span aria-hidden="true" class="text-light/40"> · </span>
          <address class="not-italic">
            {direccion}
          </address>
        </li>
      </ul>
    </div>
  </Container>
</footer>
