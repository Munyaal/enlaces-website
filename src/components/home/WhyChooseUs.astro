---
/**
 * WhyChooseUs.astro
 *
 * Sección "Por qué elegir Enlaces Playa". Reúne los argumentos clave de
 * cobertura y confianza, expone el teléfono de atención y se apoya en
 * el visual existente `persona-feliz-enlaces.webp` que ya se usa en
 * otras piezas del sitio para mantener una sola identidad visual.
 *
 * El copy vive como constante en el frontmatter para centralizar los
 * ajustes. No se introducen estilos nuevos: se reutilizan tokens y
 * patrones ya presentes en el sitio (cards, botones, tipografías).
 *
 * Todo el sizing tipográfico usa exclusivamente los tokens definidos
 * en `src/styles/typography.css`.
 */

import IconArrowRight from "../../icons/arrow-right.svg";

const TELEFONO = {
  label: "984 109 1111",
  href: "tel:+529841091111",
};

const VISUAL = {
  src: "/images/persona-feliz-enlaces.webp",
  alt: "Persona feliz con el servicio de Internet de Enlaces Playa",
};
---

<section
  aria-labelledby="why-choose-title"
  class="border-b-8 border-line bg-light px-4 py-10 sm:px-6 sm:py-12 lg:py-14"
>
  {/* Patrón de contenedor seguro, alineado con Container.astro pero con
      padding vertical propio para esta sección. */}
  <div
    class="mx-auto grid w-full max-w-7xl gap-10 md:gap-12 lg:grid-cols-2 lg:items-center lg:gap-16"
  >
    <div>
      <hr aria-hidden="true" class="w-30 max-w-35 border-t-2 border-primary" />
      <header class="mt-5 max-w-xl sm:mt-6">
        <h2
          id="why-choose-title"
          class="heading-2 mt-3 text-secondary"
        >
          <span class="text-primary">Internet</span> en la Riviera Maya:
          <span class="block text-primary">¿Por qué elegir Enlaces Playa?</span>
        </h2>
        <p class="paragraph-md mt-4 text-secondary">
          Disfruta de Internet para tu hogar o negocio, con cobertura,
          tecnología y soporte técnico local en Playa del Carmen, Puerto Morelos
          y Tulum.
        </p>
      </header>

      <div class="mt-6 md:mt-8">
        <a
          href={TELEFONO.href}
          aria-label={`Llámanos al ${TELEFONO.label}`}
          class="inline-flex w-full max-w-sm items-center justify-between gap-4 rounded-full border-2 border-primary px-5 py-3 shadow-md transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light sm:w-auto sm:gap-6 sm:px-6"
        >
          <span class="flex flex-col text-left text-secondary">
            <span class="paragraph-sm font-medium">Llámanos</span>
            <span class="heading-3 uppercase tracking-normal">
              {TELEFONO.label}
            </span>
          </span>

          <span
            aria-hidden="true"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-primary text-light"
          >
            <IconArrowRight class="h-8 w-8" />
          </span>
        </a>
      </div>
    </div>

    <div class="flex items-center justify-center">
      <img
        src={VISUAL.src}
        alt={VISUAL.alt}
        loading="lazy"
        decoding="async"
        class="w-full max-w-sm rounded-2xl object-cover sm:max-w-md"
      />
    </div>
  </div>
</section>
