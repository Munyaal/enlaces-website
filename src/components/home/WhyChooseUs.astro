---
/**
 * WhyChooseUs.astro
 *
 * Sección "Por qué elegir Enlaces Playa". Reúne los argumentos clave de
 * cobertura y confianza, expone el teléfono de atención y se apoya en
 * el visual existente `persona-feliz-enlaces.webp` que ya se usa en
 * otras piezas del sitio para mantener una sola identidad visual.
 *
 * El copy vive como constante en el frontmatter para centralizar los
 * ajustes. No se introducen estilos nuevos: se reutilizan tokens y
 * patrones ya presentes en el sitio (cards, botones, tipografías).
 */

const ARGUMENTOS = [
  {
    titulo: "Cobertura local en la Riviera Maya",
    descripcion:
      "Red propia con presencia en Playa del Carmen, Tulum, Puerto Morelos y zonas cercanas. Conocemos el terreno y llegamos donde otros no.",
  },
  {
    titulo: "Atención cercana y de confianza",
    descripcion:
      "Hablamos directo, sin enredos. Te acompañamos desde la cotización hasta la instalación y el soporte posterior.",
  },
  {
    titulo: "Equipo técnico en la región",
    descripcion:
      "Soporte técnico con personal propio en la Riviera Maya, no subcontratado, para responder con rapidez cuando lo necesites.",
  },
];

const TELEFONO = {
  label: "+52 (984) 144 0714",
  href: "tel:+529841440714",
  texto: "Llámanos y resuelve tus dudas con un asesor local",
};

const VISUAL = {
  src: "/images/persona-feliz-enlaces.webp",
  alt: "Persona feliz con el servicio de Internet de Enlaces Playa",
};
---

<section
  aria-labelledby="why-choose-title"
  class="border-b-8 border-line bg-primary px-6 py-16 md:py-20"
>
  <div class="mx-auto grid w-full max-w-7xl gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <header class="max-w-xl">
        <p
          class="text-xs font-bold uppercase tracking-widest text-accent md:text-sm"
        >
          Sobre nosotros
        </p>
        <h2
          id="why-choose-title"
          class="mt-3 text-2xl font-bold text-light md:text-4xl"
        >
          Por qué elegir Enlaces Playa
        </h2>
        <p class="mt-4 text-base text-light/85 md:text-lg">
          Más que un proveedor de Internet, somos un equipo local que
          entiende las necesidades de hogares y empresas en la Riviera Maya.
        </p>
      </header>

      <ul class="mt-8 space-y-5" role="list">
        {
          ARGUMENTOS.map((argumento) => (
            <li class="rounded-2xl border border-white/10 bg-white/5 p-5">
              <h3 class="text-lg font-semibold text-light">
                {argumento.titulo}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-light/85 md:text-base">
                {argumento.descripcion}
              </p>
            </li>
          ))
        }
      </ul>

      <div class="mt-8 rounded-2xl border border-accent/40 bg-accent/5 p-5">
        <p class="text-sm font-medium uppercase tracking-widest text-accent">
          Atención telefónica
        </p>
        <a
          href={TELEFONO.href}
          class="mt-2 block text-2xl font-bold text-light underline-offset-4 hover:underline md:text-3xl"
        >
          {TELEFONO.label}
        </a>
        <p class="mt-2 text-sm text-light/80 md:text-base">
          {TELEFONO.texto}
        </p>
      </div>
    </div>

    <div class="flex items-center justify-center">
      <img
        src={VISUAL.src}
        alt={VISUAL.alt}
        loading="lazy"
        decoding="async"
        class="w-full max-w-md rounded-2xl object-cover"
      />
    </div>
  </div>
</section>
