---
/**
 * WhyChooseUs.astro
 *
 * Sección "Por qué elegir Enlaces Playa". Reúne los argumentos clave de
 * cobertura y confianza, expone el teléfono de atención y se apoya en
 * el visual existente `persona-feliz-enlaces.webp` que ya se usa en
 * otras piezas del sitio para mantener una sola identidad visual.
 *
 * El copy vive como constante en el frontmatter para centralizar los
 * ajustes. No se introducen estilos nuevos: se reutilizan tokens y
 * patrones ya presentes en el sitio (cards, botones, tipografías).
 */

import IconArrowRight from '../../icons/arrow-right.svg'

const TELEFONO = {
  label: "984 109 1111",
  href: "tel:+529841091111",
};

const VISUAL = {
  src: "/images/persona-feliz-enlaces.webp",
  alt: "Persona feliz con el servicio de Internet de Enlaces Playa",
};
---

<section
  aria-labelledby="why-choose-title"
  class="border-b-8 border-line bg-light p-6"
>
  <div
    class="mx-auto grid w-full max-w-7xl gap-10 lg:grid-cols-2 lg:items-center"
  >
    <div>
      <hr class="border-primary border max-w-35" />
      <header class="max-w-xl mt-6">
        <h2
          id="why-choose-title"
          class="mt-3 text-2xl font-bold text-secondary md:text-4xl"
        >
          <span class="text-primary">Internet</span> en la Riviera Maya:
        </h2>
        <h2
          id="why-choose-title"
          class="mt-2 text-2xl font-bold text-secondary md:text-4xl"
        >
          ¿Por qué elegir <p class="text-primary mt-2">Enlaces Playa?</p>
        </h2>
        <p class="mt-4 text-secondary font-medium md:text-lg">
          Disfruta de Internet para tu hogar o negocio, con cobertura,
          tecnología y soporte técnico local en Playa del Carmen, Puerto Morelos
          y Tulum.
        </p>
      </header>

      <div class="mt-6 text-secondary md:mt-auto md:pt-6">
        <a
          href={TELEFONO.href}
          class="inline-flex border-2 gap-6 border-primary items-center justify-center rounded-full px-6 py-3 text-base font-bold shadow-md transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light"
        >
          <div class="flex flex-col text-secondary">
            <span
              class="text-sm font-medium"
            >
              Llámanos
            </span>
            <span
              class="text-3xl font-bold uppercase tracking"
            >
              {TELEFONO.label}
            </span>
          </div>

          <span
            class="flex h-12 w-12 items-center justify-center rounded-full border text-light bg-primary"
          >
            <IconArrowRight class="h-8 w-8"/>
          </span>
        </a>
      </div>
    </div>

    <div class="flex items-center justify-center">
      <img
        src={VISUAL.src}
        alt={VISUAL.alt}
        loading="lazy"
        decoding="async"
        class="w-full max-w-md rounded-2xl object-cover"
      />
    </div>
  </div>
</section>
