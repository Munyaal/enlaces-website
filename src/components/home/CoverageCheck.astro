---
/**
 * CoverageCheck.astro
 *
 * Sección de consulta de cobertura de la página principal. Reúne el
 * copy introductorio, un formulario simple con campo de código postal
 * y una llamada a la acción hacia la página de Cobertura completa.
 *
 * El formulario es no bloqueante: por ahora navega a la página de
 * detalle pasando el código postal como parámetro de URL. Esto evita
 * añadir dependencias de backend o animaciones nuevas y mantiene el
 * alcance del cambio en contenido/estructura semántica.
 */
import IconMapPin from "../../icons/map-pin.svg";

const CTA = {
  label: "Consultar cobertura",
  href: "/cobertura",
};
---

<section
  aria-labelledby="coverage-check-title"
  class="border-b-8 border-line bg-secondary px-6 py-16 md:py-20"
>
  <div class="mx-auto w-full max-w-4xl text-center">
    <header class="mx-auto max-w-3xl">
      <h2
        id="coverage-check-title"
        class="mt-3 text-2xl font-bold text-light md:text-4xl"
      >
        ¿Buscas <span class="text-primary">Internet</span> con cobertura <p>
          en la <span class="text-primary">Riviera Maya?</span>
        </p>
      </h2>
      <p class="mt-4 text-base text-light/85 md:text-lg">
        Consulta la disponibilidad de nuestro servicio en Playa del Carmen,
        Puerto Morelos y Tulum y encuentra la opción de conexión ideal para tu
        hogar o negocio.
      </p>
    </header>
    <div class="mt-6 text-secondary md:mt-auto md:pt-6">
      <div
        class="inline-flex border-2 gap-6  bg-light items-center justify-center rounded-full px-6 py-3 text-base font-bold shadow-md transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light"
      >
          <IconMapPin
            class="h-12 w-12 text-primary"
          />
        <form
          action={CTA.href}
          method="get"
          class="flex w-full max-w-xl flex-col gap-3 sm:flex-row sm:items-baseline"
          aria-label="Consulta de cobertura por código postal"
        >
          <div class="flex-1 text-left">
            <input
              id="postal-code"
              name="cp"
              type="text"
              inputmode="numeric"
              pattern="[0-9]{4,5}"
              maxlength="5"
              placeholder="Ingresa tu código postal"
              required
              class="block w-full py-2 text-secondary placeholder-gray-400 focus:outline-none"
            />
          </div>
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-full bg-primary px-6 py-3 text-base font-bold text-light shadow-md transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light"
          >
            {CTA.label}
          </button>
        </form>
      </div>
    </div>
    <p class="mt-4 text-xs text-light/70 md:text-sm">
      Consulta la disponibilidad de nuestro servicio en Playa del Carmen, Puerto
      Morelos y Tulum.
    </p>
  </div>
</section>
