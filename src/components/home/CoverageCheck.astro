---
/**
 * CoverageCheck.astro
 *
 * Sección de consulta de cobertura de la página principal. Reúne el
 * copy introductorio, un formulario simple con campo de código postal
 * y una llamada a la acción hacia la página de Cobertura completa.
 *
 * El formulario es no bloqueante: por ahora navega a la página de
 * detalle pasando el código postal como parámetro de URL. Esto evita
 * añadir dependencias de backend o animaciones nuevas y mantiene el
 * alcance del cambio en contenido/estructura semántica.
 */

const CTA = {
  label: "Consultar cobertura",
  href: "/cobertura",
};
---

<section
  aria-labelledby="coverage-check-title"
  class="border-b-8 border-line bg-secondary/10 px-6 py-16 md:py-20"
>
  <div class="mx-auto w-full max-w-4xl text-center">
    <header class="mx-auto max-w-2xl">
      <p
        class="text-xs font-bold uppercase tracking-widest text-accent md:text-sm"
      >
        Cobertura
      </p>
      <h2
        id="coverage-check-title"
        class="mt-3 text-2xl font-bold text-light md:text-4xl"
      >
        Consulta la cobertura en tu domicilio
      </h2>
      <p class="mt-4 text-base text-light/85 md:text-lg">
        Ingresa tu código postal y te diremos si llegamos con fibra óptica o
        internet inalámbrico a tu zona en la Riviera Maya.
      </p>
    </header>

    <form
      action={CTA.href}
      method="get"
      class="mx-auto mt-8 flex w-full max-w-xl flex-col gap-3 rounded-2xl border border-white/10 bg-white/5 p-5 sm:flex-row sm:items-end md:p-6"
      aria-label="Consulta de cobertura por código postal"
    >
      <div class="flex-1 text-left">
        <label
          for="postal-code"
          class="block text-sm font-medium text-light"
        >
          Código postal
        </label>
        <input
          id="postal-code"
          name="cp"
          type="text"
          inputmode="numeric"
          pattern="[0-9]{4,5}"
          maxlength="5"
          placeholder="Ej. 77710"
          required
          class="mt-2 block w-full rounded-lg border border-white/10 bg-primary px-3 py-2 text-light placeholder-light/50 focus:border-accent focus:outline-none"
        />
      </div>
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-full bg-accent bg-accent-grad-t px-6 py-3 text-base font-bold text-dark shadow-md transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light"
      >
        {CTA.label}
      </button>
    </form>

    <p class="mt-4 text-xs text-light/70 md:text-sm">
      ¿No conoces tu código postal? Visita nuestra
      <a href="/cobertura" class="underline hover:text-accent">
        página de cobertura completa
      </a>.
    </p>
  </div>
</section>
