---
/**
 * CoverageCheck.astro
 *
 * Sección de consulta de cobertura de la página principal. Reúne el
 * copy introductorio, un formulario simple con campo de código postal
 * y una llamada a la acción hacia la página de Cobertura completa.
 *
 * El formulario es no bloqueante: por ahora navega a la página de
 * detalle pasando el código postal como parámetro de URL. Esto evita
 * añadir dependencias de backend o animaciones nuevas y mantiene el
 * alcance del cambio en contenido/estructura semántica.
 *
 * Todo el sizing tipográfico usa exclusivamente los tokens definidos
 * en `src/styles/typography.css`.
 */

import { Image } from "astro:assets";
import backgroundImage from "../../assets/images/internet-playa-del-carmen-tulum-puerto-morelos.jpg";
import Container from "../Container.astro";
import IconMapPin from "../../icons/map-pin.svg";
import Button from "../ui/Button.astro";

const CTA = {
  label: "Consultar cobertura",
  href: "/cobertura",
};
---

<section
  aria-labelledby="coverage-check-title"
  class="relative isolate overflow-hidden border-b-8 border-line"
>
  {
    /* Imagen de fondo decorativa. Equivale al patrón del Hero: imagen
      absoluta que cubre el área, oscurecida con `brightness-75` y oculta
      a tecnología asistiva para no añadir ruido al lector de pantalla. */
  }
  <Image
    src={backgroundImage}
    alt="Internet Enlaces Playa, Tulum y Puerto morelos"
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover brightness-75"
  />

  {
    /* Overlay oscuro/degradado para garantizar la legibilidad del copy
      blanco sobre la imagen. Mismo gradiente que el Hero para mantener
      coherencia visual entre secciones. */
  }
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-gradient-to-r from-secondary/80 via-secondary/40 to-transparent"
  >
  </div>

  <Container>
    {
      /* Wrapper centrado. El `relative` lo posiciona por encima del fondo
        y el overlay (que usan z-index negativo). Se reutiliza `Container`
        para alinear el max-w y el padding con el resto de secciones
        (Plans, Benefits, Footer). */
    }
<div class="relative text-center">
      <h2 id="coverage-check-title" class="heading-2 text-light" data-reveal>
        ¿Buscas <span class="text-primary">Internet</span> con cobertura
        <span class="block text-primary">en la Riviera Maya?</span>
      </h2>
      <p class="paragraph-md mt-6 text-light/85" data-reveal>
        Consulta la disponibilidad de nuestro servicio en Playa del Carmen,
        Puerto Morelos y Tulum y encuentra la opción de conexión ideal para tu
        hogar o negocio.
      </p>

      <form
        action={CTA.href}
        method="get"
        data-reveal
      class="mx-auto mt-8 flex w-full max-w-2xl flex-col items-center gap-3 rounded-full bg-light p-2 shadow-md transition-transform hover:scale-[1.02] focus-within:ring-2 focus-within:ring-accent sm:mt-10 sm:flex-row sm:items-center sm:gap-2 sm:p-1.5 md:gap-4"
        aria-label="Consulta de cobertura por código postal"
      >
        <span
          aria-hidden="true"
          class="hidden shrink-0 items-center justify-center pl-3 text-primary sm:flex sm:h-10 sm:w-10"
        >
          <IconMapPin class="h-9 w-9" />
        </span>

        <label for="postal-code" class="sr-only"> Código postal </label>
        <input
          id="postal-code"
          name="cp"
          type="text"
          inputmode="numeric"
          pattern="[0-9]{4,5}"
          maxlength="5"
          placeholder="Ingresa tu código postal"
          required
          autocomplete="postal-code"
          class="block w-full bg-transparent px-4 py-3 paragraph-md text-secondary placeholder-gray-400 focus:outline-none sm:px-3 sm:py-2"
        />

        <Button>
          {CTA.label}
        </Button>
      </form>

      <p class="paragraph-xs mt-4 text-light/70" data-reveal>
        Consulta la disponibilidad de nuestro servicio en Playa del Carmen,
        Puerto Morelos y Tulum.
      </p>
    </div>
  </Container>
</section>

<script>
  import { revealOnEnter } from "../../utils/reveal";

  const init = () => {
    const section = document.querySelector(
      "section[aria-labelledby='coverage-check-title']",
    );
    if (!section) return;

    revealOnEnter({
      selector: "[data-reveal]",
      root: section,
      stagger: 0.1,
      duration: 0.55,
      y: 18,
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
