---
/**
 * "Empresas que confían" de la home.
 *
 * Los logos viven en `data/home/companies.ts` y su presentación en
 * `CompanyLogo`, de modo que la sección sólo compone encabezado y grid.
 * El grid conserva el quiebre de 2 a 3 columnas y luego a fila flexible.
 */
import Container from "../../ui/Container.astro";
import CompanyLogo from "../cards/CompanyLogo.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
import { COMPANIES } from "../../../data/home/companies";
---

<section aria-labelledby="companies-title" data-reveal-scope="companies">
  <Container>
    <SectionHeading id="companies-title">
      <span class="text-primary-on-light">Empresas</span>{' '}que confían en nuestro {' '}
      <span class="block text-primary-on-light">Internet</span>
      <Fragment slot="description">
        Conectamos empresas y negocios de la Riviera Maya con soluciones de
        Internet diseñadas para mantener sus operaciones, comunicación y
        servicios siempre activos.
      </Fragment>
    </SectionHeading>

    <div
      class="mx-auto mt-8 grid max-w-6xl grid-cols-2 place-items-center gap-6 sm:mt-10 sm:grid-cols-3 sm:gap-8 md:flex md:flex-row md:items-center md:justify-center md:gap-8 lg:gap-10"
    >
      {
        COMPANIES.map((company) => (
          <CompanyLogo
            src={company.src}
            alt={company.alt}
            width={company.width}
            height={company.height}
            className={company.className}
          />
        ))
      }
    </div>
  </Container>
</section>

<script>
  import { revealSection } from "../../../utils/reveal";

  revealSection("companies", "list");
</script>
