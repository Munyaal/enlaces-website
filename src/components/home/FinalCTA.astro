---
/**
 * FinalCTA.astro
 *
 * Cierre previo al footer con una llamada a la acción clara para
 * contratar el servicio de Internet. Reutiliza el patrón de botón ya
 * presente en el sitio (rounded-full + bg-accent + bg-accent-grad-t)
 * para mantener la consistencia visual sin introducir estilos nuevos.
 *
 * Estandariza el wrapper manual con `Container` para alinear max-w y
 * padding con el resto de secciones de la página principal (Plans,
 * CoverageCheck, Companies, Testimonio) y migra heading y párrafo a
 * los tokens tipográficos definidos en `src/styles/typography.css`.
 * Conserva `bg-primary`, los colores, el copy, el enlace, el botón, el
 * gradiente, las clases funcionales y el comportamiento responsive
 * del original. El ancho máximo específico del contenido (max-w-4xl)
 * se mantiene en un wrapper interno porque Container centraliza un
 * max-w-7xl para todas las secciones.
 */

import Container from "../Container.astro";
import Button from "../ui/Button.astro";

const PRIMARY_CTA = {
  label: "Contratar plan",
  href: "/contacto",
};
---

<section aria-labelledby="final-cta-title">
  <Container>
    <div class="space-y-8">
      <h2 id="final-cta-title" class="heading-2">
        ¿Listo para {" "}<span class="text-primary">contratar <br> Internet</span>{" "} en
        la <span class="text-primary">Riviera Maya?</span>
      </h2>
      <p class="paragraph-md max-w-xl">
        Encuentra el plan de Internet ideal para tu hogar o negocio y disfruta una
        conexión rápida y estable, con cobertura y soporte técnico local.
      </p>
       <Button>{PRIMARY_CTA.label}</Button>
    </div>
  </Container>
</section>
