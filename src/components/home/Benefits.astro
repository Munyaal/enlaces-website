---
import { Icon } from "astro-icon/components";
import Container from "../Container.astro";

/**
 * Benefits.astro
 *
 * Sección de beneficios de la página principal. Renderiza tres tarjetas
 * que se apoyan visualmente sobre la sección anterior (Hero) mediante
 * un margen negativo controlado sobre el contenedor en flujo normal,
 * evitando posicionamiento absoluto frágil y sin cubrir contenido
 * posterior (Plans).
 */
const BENEFITS = [
  {
    titulo: ["Internet que se adapta", "a tu forma de vivir"],
    icon: "wifi",
    descripcion:
      "Disfruta de una conexión de internet estable para trabajar, estudiar, hacer streaming y mantener todos tus dispositivos conectados.",
  },
  {
    titulo: ["Cobertura de Internet", "en la Riviera Maya"],
    icon: "map-pin",
    descripcion:
      "Conectamos hogares y negocios en Playa del Carmen, Puerto Morelos y Tulum, con opciones de fibra óptica e internet inalámbrico según disponibilidad.",
  },
  {
    titulo: ["Soporte", "técnico local"],
    icon: "tool",
    descripcion:
      "Atención personalizada de expertos en conectividad que conocen la Riviera Maya y tu zona.",
  },
];
---

<section aria-labelledby="benefits-title" class="px-4 sm:px-6">
  {
    /* Título accesible pero visualmente oculto para no romper el patrón
      de tarjetas que se apoyan en el Hero. */
  }
  <h2 id="benefits-title" class="sr-only">
    Beneficios del Internet en la Riviera Maya
  </h2>

  {
    /* El contenedor interno reutiliza `Container` para alinear el
      max-width y el padding con el resto de secciones (Plans, etc.). */
  }
  <Container>
    <div class="relative z-10 sm:-mt-24 lg:-mt-44 xl:-mt-64 w-full">
      <ul class="flex flex-col items-center gap-20 lg:flex-row lg:flex-nowrap lg:justify-between lg:items-stretch lg:gap-6" role="list">
        {
          BENEFITS.map((benefit) => (
            <li class="flex flex-col rounded-3xl border-2 border-light/25 px-6 py-6 text-left shadow-xl bg-light sm:rounded-2xl sm:px-8 sm:py-7 lg:px-10 w-full max-w-sm">
              <div class="mx-auto mb-2 flex items-center justify-center rounded-full bg-primary/20 h-20 w-20 sm:h-26 sm:w-26 md:h-32 md:w-32 lg:h-36 lg:w-36">
                <Icon
                  name={benefit.icon}
                  class="text-primary h-14 w-14 sm:h-20 sm:w-20 md:h-26 md:w-26"
                  aria-hidden="true"
                />
              </div>
              <h3 class="heading-6 text-center text-secondary">
                {Array.isArray(benefit.titulo)
                  ? benefit.titulo.map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))
                  : benefit.titulo}
              </h3>
              <hr
                aria-hidden="true"
                class="mx-auto mt-3 h-1 w-32 border-0 bg-accent-grad-radial sm:w-40"
              />
              <p class="paragraph-md mt-5 leading-relaxed text-secondary sm:mt-6">
                {benefit.descripcion}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</section>
