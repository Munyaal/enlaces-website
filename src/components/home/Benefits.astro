---
/**
 * Benefits.astro
 *
 * Sección de tres beneficios clave de Enlaces Playa, ubicada
 * inmediatamente después del Hero. Cada beneficio se presenta como una
 * tarjeta con un título corto y una descripción breve, manteniendo la
 * consistencia visual con el resto del sitio (cards sobre `bg-primary`,
 * bordes suaves, acentos en `text-accent`).
 *
 * El contenido vive como constante en el frontmatter para centralizar
 * futuros ajustes de copy en un solo lugar.
 */

const BENEFITS = [
  {
    titulo: "Internet adaptable",
    descripcion:
      "Planes flexibles según el uso de tu hogar o el tamaño de tu empresa, con velocidades que se ajustan a tus necesidades reales.",
  },
  {
    titulo: "Cobertura en la Riviera Maya",
    descripcion:
      "Llegamos con fibra óptica e internet inalámbrico a Playa del Carmen, Tulum, Puerto Morelos y zonas cercanas de la Riviera Maya.",
  },
  {
    titulo: "Soporte técnico local",
    descripcion:
      "Equipo técnico propio en la región, con atención cercana y respuesta rápida ante cualquier incidencia con tu servicio.",
  },
];
---

<section
  aria-labelledby="benefits-title"
  class="border-b-8 border-line bg-primary px-6 py-16 md:py-20"
>
  <div class="mx-auto w-full max-w-7xl">
    <header class="mb-10 max-w-3xl text-center md:mx-auto md:mb-14">
      <p
        id="benefits-title"
        class="text-xs font-bold uppercase tracking-widest text-accent md:text-sm"
      >
        Por qué Enlaces Playa
      </p>
      <h2
        class="mt-3 text-2xl font-bold text-light md:text-4xl"
      >
        Tres razones para conectarte con nosotros
      </h2>
    </header>

    <ul
      class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
      role="list"
    >
      {
        BENEFITS.map((benefit) => (
          <li
            class="flex flex-col rounded-2xl border border-white/10 bg-white/5 p-6 text-left shadow-sm"
          >
            <h3 class="text-xl font-semibold text-light">
              {benefit.titulo}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-light/85 md:text-base">
              {benefit.descripcion}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
