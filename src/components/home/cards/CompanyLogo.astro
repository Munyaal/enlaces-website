---
/**
 * Logo de una empresa en la sección "Empresas que confían".
 *
 * Los filtros y la opacidad son parte fija del tratamiento visual; los
 * anchos responsivos llegan por `className` para que cada logo defina su
 * tamaño sin que dos utilidades `w-*` compitan en el mismo elemento.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  className: string;
}

const { src, alt, width, height, className } = Astro.props;
---

<img
  src={src}
  alt={alt}
  loading="lazy"
  decoding="async"
  width={width}
  height={height}
  class:list={["h-auto grayscale contrast-50 brightness-75 opacity-80", className]}
  data-reveal
/>
