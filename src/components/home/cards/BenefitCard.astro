---
/**
 * Tarjeta individual de beneficios.
 *
 * Se extrajo del `<ul>` de `Benefits` para poder reutilizar el markup sin
 * duplicarlo. Sigue siendo un `<li>` porque siempre se renderiza dentro de
 * la lista semántica que controla el layout.
 */
import { Icon } from "astro-icon/components";

interface Props {
  titulo: string[];
  icon: string;
  descripcion: string;
}

const { titulo, icon, descripcion } = Astro.props;
---

<li data-reveal class="flex flex-col rounded-2xl border-2 border-light/25 px-6 py-6 text-left shadow-xl bg-light sm:px-8 sm:py-7 lg:px-10 w-full max-w-sm">
  <div class="mx-auto mb-2 flex items-center justify-center rounded-full bg-primary/20 h-20 w-20 sm:h-26 sm:w-26 md:h-32 md:w-32 lg:h-36 lg:w-36">
    <Icon
      name={icon}
      class="text-primary h-14 w-14 sm:h-20 sm:w-20 md:h-26 md:w-26"
      aria-hidden="true"
    />
  </div>
  <h3 class="heading-6 text-center text-secondary">
    {titulo.map((line, i) => (
      <>
        {i > 0 && <br />}
        {line}
      </>
    ))}
  </h3>
  <hr
    aria-hidden="true"
    class="mx-auto mt-3 h-1 w-32 border-0 bg-accent-grad-radial sm:w-40"
  />
  <p class="paragraph-md mt-5 leading-relaxed text-secondary sm:mt-6">
    {descripcion}
  </p>
</li>
