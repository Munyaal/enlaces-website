---
import { testimonios } from "../../utils/testimonio.ts";
import TestimonioCard from "../testimonioCard.astro";
---

<section aria-labelledby="companies-title">
  <div class="mt-10 text-center px-6">
    <h1 id="testimonies" class="text-3xl md:text-4xl font-bold">
      <span class="text-accent">Opiniones</span> sobre nuestro servicio de <span
        class="text-accent">Internet</span
      >
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-sm text-light/80 md:text-base">
      Conoce la experiencia de clientes que ya disfrutan de Internet rápido, estable y con soporte técnico local de Enlaces Playa.
    </p>
    <div class="flex">
      <div
        class="swiper testimonials-swiper w-full max-w-[1250px] h-[400px] relative"
      >
        <div class="swiper-wrapper">
          {
            testimonios.map((testimonio) => (
              <div class="swiper-slide">
                <TestimonioCard
                  foto={testimonio.foto}
                  name={testimonio.name}
                  message={testimonio.message}
                  rol={testimonio.rol}
                />
              </div>
            ))
          }
        </div>

        <!-- Controles -->
        <div class="swiper-pagination mt-6"></div>
        <div class="swiper-button-prev !text-line"></div>
        <div class="swiper-button-next !text-line"></div>
      </div>
    </div>
  </div>
</section>
<script>
  import Swiper from "swiper";
  import { Navigation, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/navigation";
  import "swiper/css/pagination";

  new Swiper(".testimonials-swiper", {
    modules: [Navigation, Pagination],
    grabCursor: true,
    loop: true,
    centeredSlides: false,
    spaceBetween: 20,
    breakpoints: {
      0: {
        slidesPerView: 1,
      },
      768: {
        slidesPerView: 2,
      },
      1024: {
        slidesPerView: 3,
      },
    },
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
      dynamicBullets: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
  });
</script>
