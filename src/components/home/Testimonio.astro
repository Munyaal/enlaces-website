---
/**
 * Testimonio.astro
 *
 * Sección "Opiniones" de la página principal. Presenta los testimonios
 * de clientes en un carrusel Swiper para reforzar la confianza del
 * visitante.
 *
 * Rediseño inspirado en Google Reviews: las tarjetas muestran una
 * jerarquía tipo review (encabezado con avatar/nombre, estrellas
 * amarillas, rol, mensaje legible e insignia de Google) y los
 * controles del carrusel se reestilizan para mantener coherencia
 * visual sin tocar la configuración ni el comportamiento de Swiper.
 *
 * El copy, el array de testimonios, la configuración completa de
 * Swiper, la navegación, la paginación, los breakpoints y el
 * comportamiento responsive permanecen idénticos.
 */

import { testimonios } from "../../utils/testimonio.ts";
import Container from "../Container.astro";
import TestimonioCard from "../testimonioCard.astro";
---

<section aria-labelledby="testimonios-title" class="bg-amber-100">
  <Container>
    <h2 id="testimonios-title" class="heading-2 text-center" data-reveal>
      <span class="text-primary-on-light">Opiniones</span>{" "}sobre nuestro <br /> servicio
      de <span class="text-primary-on-light">Internet</span>
    </h2>
    <hr
      aria-hidden="true"
      class="mx-auto mt-3 h-1 w-32 border-0 bg-accent-grad-radial sm:w-36"
      data-reveal
    />
    <p class="paragraph-md mx-auto mt-4 max-w-2xl text-center" data-reveal>
      Conoce la experiencia de clientes que ya disfrutan de Internet rápido,
      estable y con soporte técnico local de Enlaces Playa.
    </p>

    <div class="testimonials-carousel relative mt-8 sm:mt-10">
      <div class="swiper testimonials-swiper mx-auto w-full">
        <div class="swiper-wrapper">
          {
            testimonios.map((testimonio) => (
              <div class="swiper-slide">
                <TestimonioCard
                  foto={testimonio.foto}
                  name={testimonio.name}
                  message={testimonio.message}
                  rol={testimonio.rol}
                />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Controles: se reubican como hermanos del `.swiper` para poder
           posicionarlos fuera del área de los slides y que no tapen el
           contenido ni en móvil ni en desktop. Swiper los sigue
           encontrando por selector (nextEl / prevEl). -->
      <div class="swiper-pagination testimonials-pagination"></div>
      <div class="swiper-button-prev testimonials-prev"></div>
      <div class="swiper-button-next testimonials-next"></div>
    </div>
  </Container>
</section>

<script>
  import { revealOnEnter } from "../../utils/reveal";

  // Sólo animamos el encabezado (h2 + hr + p). El wrapper, la
  // configuración y los slides de Swiper permanecen intactos para no
  // interferir con la inicialización del carrusel.
  const init = () => {
    const section = document.querySelector(
      "section[aria-labelledby='testimonios-title']",
    );
    if (!section) return;

    revealOnEnter({
      selector: "[data-reveal]",
      root: section,
      stagger: 0.1,
      duration: 0.55,
      y: 14,
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>

<style>
  /* Estilos coherentes para los controles del carrusel: se reaplican
     sobre los botones por defecto de Swiper (SVG con `fill: currentColor`)
     sin alterar su API ni su comportamiento. Los selectores `.testimonials-swiper`
     y las clases `.swiper-button-prev` / `.swiper-button-next` las sigue
     esperando el JS del slider. */
  .testimonials-prev,
  .testimonials-next {
    --swiper-navigation-color: var(--color-secondary);
    width: 36px;
    height: 36px;
    background-color: var(--color-light);
    border: 1px solid var(--color-line);
    border-radius: 9999px;
    box-shadow: 0 4px 12px rgb(15 23 42 / 0.08);
    transition:
      transform 0.2s ease-out,
      box-shadow 0.2s ease-out,
      background-color 0.2s ease-out;
    /* Posicionados relativos al wrapper `.testimonials-carousel` para
       que no caigan sobre el contenido de los slides. */
    position: absolute;
    top: 50%;
    /* Reset explícito: Swiper aplica `margin-top: calc(-22px)` que
       interfiere con el centrado por `transform: translateY(-50%)`. */
    margin-top: 0;
    transform: translateY(-50%);
    z-index: 10;
  }

  /* Especificidad (0,2,0) para ganar a `.swiper-button-prev` /
     `.swiper-button-next` (0,1,0) de Swiper sin depender del orden
     de carga del CSS. */
  .testimonials-carousel .testimonials-prev {
    left: -8px;
  }

  .testimonials-carousel .testimonials-next {
    right: -8px;
  }

  .testimonials-prev:hover,
  .testimonials-next:hover {
    background-color: var(--color-secondary);
    --swiper-navigation-color: var(--color-light);
    transform: translateY(-50%) scale(1.05);
    box-shadow: 0 6px 16px rgb(15 23 42 / 0.14);
  }

  /* En viewports < lg los botones se reubican debajo del swiper
     (a la altura de la paginación) para no tapar el slide vertical. */
  @media (max-width: 1023px) {
    .testimonials-prev,
    .testimonials-next {
      top: auto;
      bottom: 4px;
      transform: none;
    }
    .testimonials-carousel .testimonials-prev {
      left: 0;
    }
    .testimonials-carousel .testimonials-next {
      right: 0;
    }
    /* En hover en mobile/tablet conservamos solo el scale para no
       reintroducir `translateY(-50%)` (que descentraría los botones
       al estar anclados por `bottom`). */
    .testimonials-prev:hover,
    .testimonials-next:hover {
      transform: scale(1.05);
    }
  }

  /* En móvil los botones quedan ligeramente más compactos para no
     invadir el área de las tarjetas. */
  @media (max-width: 639px) {
    .testimonials-prev,
    .testimonials-next {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/navigation";
  import "swiper/css/pagination";

  new Swiper(".testimonials-swiper", {
    modules: [Navigation, Pagination],
    grabCursor: true,
    loop: true,
    centeredSlides: false,
    spaceBetween: 20,
    breakpoints: {
      0: {
        slidesPerView: 1,
      },
      768: {
        slidesPerView: 2,
      },
      1024: {
        slidesPerView: 3,
      },
    },
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
      dynamicBullets: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
  });
</script>
