---
/**
 * Plans.astro
 *
 * Sección que muestra los dos grandes bloques de planes de Internet
 * de Enlaces Playa: Hogar y Empresas. Cada plan incluye un título,
 * una descripción breve, un precio orientativo y una llamada a la
 * acción hacia la página de detalle correspondiente.
 *
 * El copy vive como constante en el frontmatter para mantener el
 * template declarativo y concentrar futuros ajustes en un solo lugar.
 * Los precios son orientativos y se exponen como texto porque el
 * tarifario real vive en las páginas de detalle (internet-hogar y
 * internet-empresas).
 *
 * Todo el sizing tipográfico usa exclusivamente los tokens definidos
 * en `src/styles/typography.css`.
 */

import IconHome from "../../icons/home.svg";
import IconBuilding from "../../icons/building.svg";
import IconArrowRight from "../../icons/arrow-right.svg";
import Container from "../Container.astro";

const PLANS = [
  {
    tipo: "hogar",
    titulo: "Internet para hogar",
    descripcion:
      "Internet rápido y estable para trabajar, estudiar, disfrutar streaming y conectar todos tus dispositivos.",
    precio: "$499",
    cta: {
      label: "Ver planes para hogar",
      href: "/internet-hogar",
    },
  },
  {
    tipo: "empresarial",
    titulo: "Internet para tu negocio",
    descripcion:
      "Soluciones de internet para mantener conectados tus sistemas, operaciones, clientes y equipos.",
    precio: "$899",
    cta: {
      label: "Ver planes para empresa",
      href: "/internet-empresas",
    },
  },
];
---

<section aria-labelledby="plans-title">
  <Container>
    <h2
      id="plans-title"
      class="heading-2 text-center text-secondary"
    >
      <span class="text-primary">Internet</span> para Hogar y Empresas <br /> en la
      {" "}
      <span class="text-primary">Riviera Maya</span>
    </h2>
    <hr
      aria-hidden="true"
      class="mx-auto mt-3 h-1 w-32 border-0 bg-accent-grad-r sm:w-36"
    />
    <p class="paragraph-md mt-6 text-center text-secondary">
      Encuentra la solución de conectividad que necesitas, ya sea para tu hogar,
      negocio o empresa.
    </p>

    <div
      class="mt-10 flex flex-col items-stretch justify-center gap-6 md:mt-12 md:flex-row md:items-center md:gap-8 lg:gap-12 xl:gap-16"
    >
      {
        PLANS.map((plan) => (
          <article
            class:list={[
              "flex w-full max-w-md flex-col rounded-2xl border p-6 text-center shadow-2xl sm:p-7 md:max-w-md md:p-8",
              plan.tipo === "empresarial"
                ? "border-secondary bg-secondary text-white"
                : "border-secondary/10 bg-white text-secondary",
            ]}
          >
            <div
              class:list={[
                "mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-accent bg-secondary text-accent",
              ]}
            >
              {plan.tipo === "empresarial" ? (
                <IconBuilding class="h-10 w-10" aria-hidden="true" />
              ) : (
                <IconHome class="h-10 w-10" aria-hidden="true" />
              )}
            </div>
            <h3
              class:list={[
                "heading-3 mt-5 text-center",
                plan.tipo === "empresarial" ? "text-white" : "text-dark",
              ]}
            >
              {plan.titulo}
            </h3>
            <hr
              aria-hidden="true"
              class:list={[
                "mx-auto mt-3 h-px w-24 border-0 border-t",
                plan.tipo === "empresarial" ? "border-white/40" : "border-primary",
              ]}
            />
            <p
              class:list={[
                "paragraph-md mt-5 text-center leading-relaxed",
                plan.tipo === "empresarial" ? "text-white" : "text-secondary",
              ]}
            >
              {plan.descripcion}
            </p>
            <p
              class:list={[
                "paragraph-xs mt-6 text-center font-semibold uppercase tracking-[0.18em]",
                plan.tipo === "empresarial" ? "text-white" : "text-secondary",
              ]}
            >
              DESDE
            </p>
            <p class="mt-2 flex items-end justify-center gap-1">
              <span
                class:list={[
                  "heading-2 leading-none",
                  plan.tipo === "empresarial" ? "text-white" : "text-secondary",
                ]}
              >
                {plan.precio}
              </span>
              <span
                class:list={[
                  "paragraph-xs pb-1 text-center uppercase tracking-wide",
                  plan.tipo === "empresarial"
                    ? "text-white/80"
                    : "text-secondary/80",
                ]}
              >
                /mes
              </span>
            </p>
            <div class="mt-6 md:mt-auto md:pt-6">
              <a
                href={plan.cta.href}
                class:list={[
                  "inline-flex w-full items-center justify-center gap-2 rounded-full px-6 py-3 paragraph-md font-bold shadow-md transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light sm:w-auto",
                  plan.tipo === "empresarial"
                    ? "bg-secondary text-light border border-accent "
                    : "bg-secondary text-light border border-white",
                ]}
              >
                {plan.cta.label}
                <span
                  class:list={[
                    "inline-flex h-8 w-8 items-center justify-center rounded-full border",
                    plan.tipo === "empresarial"
                      ? "border-white/30 bg-accent text-secondary"
                      : "border-white/30 bg-light text-primary",
                  ]}
                  aria-hidden="true"
                >
                  <IconArrowRight class="h-6 w-6" />
                </span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Container>
</section>
