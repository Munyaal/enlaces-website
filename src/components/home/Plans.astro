---
/**
 * Plans.astro
 *
 * Sección que muestra los dos grandes bloques de planes de Internet
 * de Enlaces Playa: Hogar y Empresas. Cada plan incluye un título,
 * una descripción breve, un precio orientativo y una llamada a la
 * acción hacia la página de detalle correspondiente.
 *
 * El copy vive como constante en el frontmatter para mantener el
 * template declarativo y concentrar futuros ajustes en un solo lugar.
 * Los precios son orientativos y se exponen como texto porque el
 * tarifario real vive en las páginas de detalle (internet-hogar y
 * internet-empresas).
 *
 * La presentación de cada plan se delega a `PackageCard.astro` para
 * reutilizar el markup y mantener la variante visual (hogar vs
 * empresarial) centralizada en un único componente.
 *
 * Todo el sizing tipográfico usa exclusivamente los tokens definidos
 * en `src/styles/typography.css`.
 */

import Container from "../Container.astro";
import PackageCard from "./PackageCard.astro";

// Tipo explícito para que `plan.tipo` sea compatible con la unión
// `"hogar" | "empresarial"` esperada por `PackageCard`.
type Plan = {
  tipo: "hogar" | "empresarial";
  icon: string;
  titulo: string;
  descripcion: string;
  precio: string;
  cta: {
    label: string;
    href: string;
  };
};

const PLANS: Plan[] = [
  {
    tipo: "hogar",
    icon: "home",
    titulo: "Internet para hogar",
    descripcion:
      "Internet rápido y estable para trabajar, estudiar, disfrutar streaming y conectar todos tus dispositivos.",
    precio: "$499",
    cta: {
      label: "Ver planes para hogar",
      href: "/internet-hogar",
    },
  },
  {
    tipo: "empresarial",
    icon: "building",
    titulo: "Internet para tu negocio",
    descripcion:
      "Soluciones de internet para mantener conectados tus sistemas, operaciones, clientes y equipos.",
    precio: "$899",
    cta: {
      label: "Ver planes para empresa",
      href: "/internet-empresas",
    },
  },
];
---

<section aria-labelledby="plans-title">
  <Container>
    <h2
      id="plans-title"
      class="heading-2 text-center text-secondary"
      data-reveal
    >
      <span class="text-primary-on-light">Internet</span> para Hogar y Empresas <br /> en la
      {" "}
      <span class="text-primary-on-light">Riviera Maya</span>
    </h2>
    <hr
      aria-hidden="true"
      class="mx-auto mt-3 h-1 w-32 border-0 bg-accent-grad-radial sm:w-36"
      data-reveal
    />
    <p class="paragraph-md mt-6 text-center text-secondary" data-reveal>
      Encuentra la solución de conectividad que necesitas, ya sea para tu hogar,
      negocio o empresa.
    </p>

    <div
      class="mt-10 flex flex-col items-stretch justify-center gap-6 md:mt-12 md:flex-row md:items-center md:gap-8 lg:gap-12 xl:gap-16"
    >
      {
        PLANS.map((plan) => (
          <PackageCard
            tipo={plan.tipo}
            icon={plan.icon}
            titulo={plan.titulo}
            descripcion={plan.descripcion}
            precio={plan.precio}
            cta={plan.cta}
            reveal
          />
        ))
      }
    </div>
  </Container>
</section>

<script>
  import { revealOnEnter } from "../../utils/reveal";

  // Título + divisor + intro entran primero, luego las dos tarjetas con
  // un stagger corto. ScrollTrigger `once: true` evita re-animar.
  const init = () => {
    const section = document.querySelector(
      "section[aria-labelledby='plans-title']",
    );
    if (!section) return;

    revealOnEnter({
      selector: "[data-reveal]",
      root: section,
      stagger: 0.1,
      duration: 0.55,
      y: 18,
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
