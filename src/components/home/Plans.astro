---
/**
 * Plans.astro
 *
 * Sección que muestra los dos grandes bloques de planes de Internet
 * de Enlaces Playa: Hogar y Empresas. Cada plan incluye un título,
 * una descripción breve, un precio orientativo y una llamada a la
 * acción hacia la página de detalle correspondiente.
 *
 * El copy vive como constante en el frontmatter para mantener el
 * template declarativo y concentrar futuros ajustes en un solo lugar.
 * Los precios son orientativos y se exponen como texto porque el
 * tarifario real vive en las páginas de detalle (internet-hogar y
 * internet-empresas).
 */

import IconHome from "../../icons/home.svg";
import IconBuilding from "../../icons/building.svg";
import IconArrowRight from "../../icons/arrow-right.svg";

const PLANS = [
  {
    tipo: "hogar",
    titulo: "Internet para hogar",
    descripcion:
      "Internet rápido y estable para trabajar, estudiar, disfrutar streaming y conectar todos tus dispositivos.",
    precio: "$499",
    cta: {
      label: "Ver planes para hogar",
      href: "/internet-hogar",
    },
  },
  {
    tipo: "empresarial",
    titulo: "Internet para tu negocio",
    descripcion:
      "Soluciones de internet para mantener conectados tus sistemas, operaciones, clientes y equipos.",
    precio: "$899",
    cta: {
      label: "Ver planes para empresa",
      href: "/internet-empresas",
    },
  },
];
---

<section
  aria-labelledby="plans-title"
  class="border-b-8 border-line bg-light px-6 pt-16 md:pt-20"
>
  <div class="mx-auto w-full max-w-7xl justify-center text-center items-center">
    <header class="mb-10 text-center md:mx-auto md:mb-14">
      <h2 id="plans-title" class="heading-2 mt-3 font-bold text-secondary">
        <span class="text-primary">Internet</span> para Hogar y Empresas<p>
          en la <span class="text-primary">Riviera Maya</span>
        </p>
      </h2>
      <hr class="w-36 h-1 bg-accent-grad-r border-0 mx-auto" />
      <p class="paragraph-md mt-6 text-secondary">
        Encuentra la solución de conectividad que necesitas, ya sea para tu
        hogar, negocio o empresa.
      </p>
    </header>

    <div
      class="flex flex-col md:flex-row gap-8 md:gap-28 items-center justify-center"
    >
      {
        PLANS.map((plan) => (
          <article
            class:list={[
              "flex flex-col max-w-100 rounded-2xl border p-6 text-center shadow-2xl md:p-8",
              plan.tipo === "empresarial"
                ? "border-secondary bg-secondary text-white"
                : "border-secondary/10 bg-white text-secondary",
            ]}
          >
            <div
              class:list={[
                "mx-auto flex h-16 w-16 items-center justify-center rounded-full border border-accent bg-secondary text-accent",
              ]}
            >
              {plan.tipo === "empresarial" ? (
                <IconBuilding class="h-10 w-10" />
              ) : (
                <IconHome class="h-10 w-10" />
              )}
            </div>
            <h3
              class:list={[
                "mt-5 text-xl font-semibold md:text-2xl",
                plan.tipo === "empresarial" ? "text-white" : "text-dark",
              ]}
            >
              {plan.titulo}
            </h3>
            <hr class="mx-auto mt-3 h-px w-24 border-primary" />
            <p
              class:list={[
                "mt-5 text-sm leading-relaxed md:text-base",
                plan.tipo === "empresarial" ? "text-white" : "text-secondary",
              ]}
            >
              {plan.descripcion}
            </p>
            <p
              class:list={[
                "mt-6 text-sm font-semibold uppercase tracking-[0.18em]",
                plan.tipo === "empresarial" ? "text-white" : "text-secondary",
              ]}
            >
              DESDE
            </p>
            <p class="mt-2 flex items-end justify-center gap-1">
              <span
                class:list={[
                  "text-4xl font-black leading-none md:text-5xl",
                  plan.tipo === "empresarial" ? "text-white" : "text-secondary",
                ]}
              >
                {plan.precio}
              </span>
              <span
                class:list={[
                  "pb-1 text-[10px] font-medium uppercase tracking-wide",
                  plan.tipo === "empresarial"
                    ? "text-white/80"
                    : "text-secondary/80",
                ]}
              >
                /mes
              </span>
            </p>
            <div class="mt-6 md:mt-auto md:pt-6">
              <a
                href={plan.cta.href}
                class:list={[
                  "inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-base font-bold shadow-md transition-transform hover:scale-[1.03] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-light",
                  plan.tipo === "empresarial"
                    ? "bg-secondary text-light border border-accent "
                    : "bg-secondary text-light border border-white",
                ]}
              >
                {plan.cta.label}
                <div
                  class:list={[
                    "mx-auto flex h-8 w-8 items-center justify-center rounded-full border",
                    plan.tipo === "empresarial"
                      ? "border-white/30 bg-accent text-secondary"
                      : "border-white/30 bg-light text-primary",
                  ]}
                >
                  <IconArrowRight class="h-6 w-6" />
                </div>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
