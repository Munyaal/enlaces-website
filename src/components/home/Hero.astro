---
import { Image } from "astro:assets";
import internetEnlacesPlaya from "../../assets/images/internet-riviera-maya-enlaces-playa.jpg";
import Button from "../ui/Button.astro";

---

<header
  class="relative isolate w-full min-h-[600px] md:min-h-[660px] lg:min-h-[920px] overflow-hidden"
>
  {/* Imagen de fondo (decorativa) */}
  <Image
    src={internetEnlacesPlaya}
    alt={"Imagen de fondo del Hero"}
    aria-hidden="true"
    loading="eager"
    decoding="async"
    data-hero-background
    class="absolute inset-0 -z-20 h-full w-full object-cover brightness-75"
  />

  {
    /* Overlay sutil para legibilidad. El `brightness-75` se conserva en la
      imagen; este degradado solo oscurece la franja donde va el texto. */
  }
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-gradient-to-r from-secondary/80 via-secondary/40 to-transparent"
  >
  </div>

  <div
    class="relative mx-auto flex h-full w-full max-w-7xl flex-col items-center justify-center px-6 py-24 md:items-start md:py-28 lg:py-32"
  >
    <div class="mt-20">
      <h1 class="heading-1 text-balance text-light text-center md:text-left">
        <span class="text-primary">Internet</span>{" "}
        para tu hogar y negocio{" "}
        <span class="text-primary">en la Riviera Maya</span>{" "}
      </h1>

      <hr class="w-36 h-1 bg-accent-grad-r border-0 my-4 mx-auto md:ml-0" />

      <p
        class="paragraph-md max-w-3xl text-pretty text-center text-light/90 md:text-left"
      >
        Conecta tu hogar o negocio con Internet de alta velocidad en la{
          " "
        }<span class="text-accent font-semibold">Riviera Maya.</span>{" "}
        Enlaces Playa ofrece soluciones de Internet para Hogar y Empresas en{
          " "
        }
        <span class="text-accent">Playa del Carmen, Puerto Morelos y Tulum</span
        >{" "}
        , con opciones de fibra óptica e Internet inalámbrico, instalación profesional
        y soporte técnico local.
      </p>

      <div
        class="mt-8 flex flex-col items-center gap-3 sm:mt-10 sm:flex-row sm:gap-4 md:items-start"
      >
        <Button as="a" href="/internet-hogar" size="lg" icon="wifi" variant="navy">
          Ver planes y precios
        </Button>
        <Button as="a" href="/cobertura" size="lg" icon="map-pin">
          Consultar cobertura
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  import { gsap } from "gsap";

  // Zoom in/out muy leve en loop SOLO sobre la imagen de fondo del Hero.
  // Respeta prefers-reduced-motion: si el usuario lo tiene activo, no anima.
  const initHeroBackgroundZoom = () => {
    const bg = document.querySelector<HTMLImageElement>(
      "[data-hero-background]",
    );
    if (!bg) return;

    const motionQuery = window.matchMedia(
      "(prefers-reduced-motion: no-preference)",
    );
    if (!motionQuery.matches) return;

    const ctx = gsap.context(() => {
      gsap.to(bg, {
        scale: 1.03,
        duration: 8,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
        transformOrigin: "center",
      });
    });

    // Si el usuario cambia la preferencia en tiempo real, matamos la animación.
    motionQuery.addEventListener("change", (e) => {
      if (!e.matches) ctx.revert();
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeroBackgroundZoom);
  } else {
    initHeroBackgroundZoom();
  }
</script>
