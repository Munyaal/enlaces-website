---
/**
 * PackageCard.astro
 *
 * Tarjeta reutilizable para los paquetes/planes de la sección `Plans`
 * de la home. Renderiza el ícono, título, descripción, precio y CTA de
 * un plan.
 *
 * La variante visual (hogar vs empresarial) se deriva del prop `tipo`
 * y replica las clases que existían inline en `Plans.astro` para que
 * la extracción de markup a este componente no introduzca cambios
 * visuales.
 *
 * Props:
 *   - tipo:        'hogar' | 'empresarial'. Define fondo/texto y variante del CTA.
 *   - icon:        nombre de icono astro-icon (Tabler) que se muestra sobre la card.
 *   - titulo:      título visible del paquete.
 *   - descripcion: descripción corta del paquete.
 *   - precio:      precio desde (p. ej. "$499"), se expone como texto.
 *   - cta:         { label, href } consumido por `CTAButton`.
 *   - reveal:      opcional. Si es true, añade `data-reveal` al article
 *                  para que el padre lo recoja en una entrada escalonada.
 *
 * Todo el sizing tipográfico usa exclusivamente los tokens definidos
 * en `src/styles/typography.css`.
 */

import { Icon } from "astro-icon/components";
import CTAButton from "../ui/CTAButton.astro";

type Tipo = "hogar" | "empresarial";

interface Props {
  tipo: Tipo;
  icon: string;
  titulo: string;
  descripcion: string;
  precio: string;
  cta: {
    label: string;
    href: string;
  };
  reveal?: boolean;
}

const {
  tipo,
  icon,
  titulo,
  descripcion,
  precio,
  cta,
  reveal = false,
} = Astro.props;

// Clases condicionales equivalentes a las ramas
// `plan.tipo === "empresarial" ? … : …` que existían inline en Plans.astro.
const isEmpresarial = tipo === "empresarial";

const articleClasses = [
  "flex w-full max-w-md flex-col rounded-2xl border p-6 text-center shadow-2xl sm:p-7 md:max-w-md md:p-8",
  isEmpresarial
    ? "border-secondary bg-secondary text-white"
    : "border-secondary/10 bg-white text-secondary",
];

const titleClasses = [
  "heading-6 mt-6 text-center",
  isEmpresarial ? "text-white" : "text-dark",
];

const descriptionClasses = [
  "paragraph-md mt-5 text-center leading-relaxed",
  isEmpresarial ? "text-white" : "text-secondary",
];

const desdeClasses = [
  "paragraph-xs mt-8 text-center font-semibold uppercase tracking-[0.18em]",
  isEmpresarial ? "text-white" : "text-secondary",
];

const priceClasses = [
  "heading-2 leading-none",
  isEmpresarial ? "text-white" : "text-secondary",
];

const perMonthClasses = [
  "paragraph-xs pb-1 text-center uppercase tracking-wide",
  isEmpresarial ? "text-white/80" : "text-secondary/80",
];
---

<article class:list={articleClasses} data-reveal={reveal ? "" : undefined}>
  <div
    class:list={[
      "mx-auto flex h-20 w-20 items-center justify-center rounded-full border border-accent bg-secondary text-accent",
    ]}
  >
    <Icon class="h-14 w-14" name={icon} aria-hidden="true" />
  </div>
  <h3 class:list={titleClasses}>{titulo}</h3>

  <hr
    aria-hidden="true"
    class="mx-auto mt-2 h-0.5 w-32 border-0 bg-accent-grad-radial"
  />

  <p class:list={descriptionClasses}>{descripcion}</p>
  <p class:list={desdeClasses}>DESDE</p>

  <p class="mt-2 mb-2 flex items-end justify-center gap-1">
    <span class:list={priceClasses}>{precio}</span>
    <span class:list={perMonthClasses}>/mes</span>
  </p>
  <div class="mt-6 md:mt-auto md:pt-6">
    <CTAButton
      variant={isEmpresarial ? "solid" : "navy"}
      href={cta.href}
    >
      {cta.label}
    </CTAButton>
  </div>
</article>
