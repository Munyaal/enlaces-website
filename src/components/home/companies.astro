---
/**
 * Companies.astro
 *
 * Sección "Empresas que confían" de la página principal. Muestra los
 * logos de las marcas que forman parte del grupo y los presenta con un
 * encabezado introductorio para reforzar la confianza del visitante.
 *
 * Se conserva la estructura de marcado y las clases existentes para
 * evitar un rediseño visual; solo se ajustan el título y el copy
 * introductorio definidos en el SDD aprobado.
 */
---

<section
  aria-labelledby="companies-title"
  class="border-b-8 border-line bg-light p-6"
>
  <div class="mt-10 text-center px-6 text-secondary">
    <h1 id="companies-title" class="text-3xl md:text-4xl font-bold">
      <span class="text-primary">Empresas</span> que confían <p class="mt-2">
        en nuestro <span class="text-primary">Internet</span>
      </p>
    </h1>
    <hr class="mx-auto mt-2 max-w-30 border-t-2 border-primary" />
    <p class="mx-auto mt-4 max-w-4xl text-sm md:text-base">
      Conectamos empresas y negocios de la Riviera Maya con soluciones de
      Internet diseñadas para mantener sus operaciones, comunicación y servicios
      siempre activos.
    </p>
  </div>
  <div class="flex flex-col md:flex-row place-items-center justify-center my-5 mx-12 gap-4 md:gap-8 lg:gap-10">
    <img
      src="/images/logos/logo-colegio.png"
      alt="Logo Colegio"
      class="w-28 sm:w-32 lg:w-36 grayscale contrast-50 brightness-75 opacity-80"
    />
    <img
      src="/images/logos/logo-leones.png"
      alt="Logo Leones"
      class="w-24 sm:w-24 lg:w-28 grayscale contrast-50 brightness-75 opacity-80"
    />
    <img
      src="/images/logos/logo-munyaal.webp"
      alt="Logo Munyaal"
      class="w-28 sm:w-32 lg:w-36 grayscale contrast-50 brightness-75 opacity-80"
    />
    <img
      src="/images/logos/logo-cui.svg"
      alt="Logo CUI"
      class="w-28 sm:w-32 lg:w-36 grayscale contrast-50 brightness-75 opacity-80"
    />
    <img
      src="/images/logos/logo-idiomar.webp"
      alt="Logo Idiomar"
      class="w-28 sm:w-32 lg:w-36 grayscale contrast-50 brightness-75 opacity-80"
    />
  </div>
</section>
