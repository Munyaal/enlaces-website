---
/**
 * BaseHead.astro
 *
 * Encapsula todas las etiquetas <head> condivididas del sitio (charset, viewport,
 * favicon, título, SEO básico y Open Graph / Twitter Cards).
 *
 * Se renderiza dentro de <head> desde Layout.astro para mantener el layout
 * enfocado en su responsabilidad: actuar como el "contenedor general" del sitio
 * (navbar + contenido + footer) y delegar los metadatos a este componente.
 *
 * Props:
 *   - title:       obligatorio, título de la pestaña.
 *   - description: opcional, sobrescribe la descripción default del sitio.
 *   - keywords:    opcional, sobrescribe las keywords default del sitio.
 */
interface Props {
  title: string;
  description?: string;
  keywords?: string;
}

const DEFAULT_DESCRIPTION =
  "Enlaces Playa ofrece servicios de internet por fibra óptica y antena satelital en Playa del Carmen, Tulum, Puerto Morelos y Bacalar. Conéctate con velocidad y estabilidad desde cualquier punto de Quintana Roo.";

const DEFAULT_KEYWORDS =
  "Internet Playa del Carmen, fibra óptica Tulum, internet satelital Bacalar, Puerto Morelos internet, Enlaces Playa, internet rápido Quintana Roo, conexión estable, servicios de internet Riviera Maya";

const { title, description = DEFAULT_DESCRIPTION, keywords = DEFAULT_KEYWORDS } =
  Astro.props;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />

{/* Tipografía del sitio: Poppins (primaria) + SkolaSans (display), servidas
   localmente desde /public/fonts/ y declaradas en src/styles/global.css. */}
<meta name="generator" content={Astro.generator} />
<title>{title}</title>

<meta name="description" content={description} />

<meta name="keywords" content={keywords} />

<meta property="og:type" content="website" />
<meta property="og:url" content="https://enlacesplaya.com.mx/" />
<meta
  property="og:title"
  content="Enlaces Playa | Internet en Playa del Carmen y la Riviera Maya"
/>
<meta
  property="og:description"
  content="Conectamos Playa del Carmen, Tulum, Bacalar y Puerto Morelos con internet por fibra óptica y antena satelital de alta velocidad."
/>
<meta property="og:image" content="/banner-enlaces-playa.webp" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content="https://enlacesplaya.com.mx/" />
<meta
  name="twitter:title"
  content="Enlaces Playa | Internet Rápido en la Riviera Maya"
/>
<meta
  name="twitter:description"
  content="Fibra óptica y antena satelital en Playa del Carmen, Tulum, Bacalar y Puerto Morelos. Velocidad, estabilidad y cobertura garantizada."
/>
<meta name="twitter:image" content="/banner-enlaces-playa.webp" />