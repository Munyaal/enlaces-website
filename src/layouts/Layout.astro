---
import Navbar from "../components/layout/Navbar.astro";
import BaseHead from "../components/layout/BaseHead.astro";
import "../styles/global.css";
import Footer from "../components/layout/Footer.astro";
import GoogleTagManager from "../components/layout/GoogleTagManager.astro";
import GoogleTagManagerNoScript from "../components/layout/GoogleTagManagerNoScript.astro";

/**
 * Layout.astro
 *
 * Props:
 *   - title:       obligatorio, título de la pestaña.
 *   - description: opcional, sobrescribe la descripción SEO por página.
 *   - keywords:    opcional, sobrescribe las keywords SEO por página.
 *   - surface:     superficie del contenido. "light" (default) deja el
 *                  fondo del body; "dark" pinta `<main>` con el azul de
 *                  marca y texto claro para páginas de documento
 *                  (legales, ayuda) que no usan `PageHero`.
 *
 * `surface="dark"` añade `pt-24` porque el navbar es `fixed`: sin ese
 * respiro el `<h1>` queda debajo del navbar. 96px libra los 64px de
 * móvil y los 88px de desktop.
 */
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  surface?: "light" | "dark";
}

const { title, description, keywords, surface = "light" } = Astro.props;

const mainClasses = surface === "dark" ? "bg-secondary text-light pt-24" : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <GoogleTagManager />
    <BaseHead title={title} description={description} keywords={keywords} />
  </head>
  <body class="text-dark font-sans">
    <GoogleTagManagerNoScript />
    <Navbar />
    <main class={mainClasses}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
