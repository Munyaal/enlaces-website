---
import Layout from "../layouts/Layout.astro";
import InternetEmpresasHero from "../components/internet-empresas/InternetEmpresasHero.astro";
import EmpresasSolution from "../components/internet-empresas/EmpresasSolution.astro";
import EmpresasStats from "../components/internet-empresas/EmpresasStats.astro";
import EmpresasSectors from "../components/internet-empresas/EmpresasSectors.astro";
import WhyChoseEmpresas from "../components/internet-empresas/WhyChoseEmpresas.astro";
import ReadyToGetwork from "../components/internet-empresas/ReadyToGetwork.astro";
import { AREA_SERVED, ORGANIZACION, SITE_URL } from "../data/seo";

const title =
  "Internet para Empresas | Soluciones de Conectividad | Enlaces Playa";
const description =
  "Soluciones de Internet para Empresas en la Riviera Maya. Conectamos hoteles, inmobiliarias, oficinas y negocios con soporte técnico local y cobertura en Playa del Carmen, Tulum y Puerto Morelos.";
const keywords =
  "internet para empresas, internet empresarial, internet para negocios, internet empresarial en cancún, internet empresarial en playa del carmen, internet empresarial en tulum";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Internet para Empresas",
  "name": title,
  "description": description,
  "provider": ORGANIZACION,
  "areaServed": AREA_SERVED,
  "url": `${SITE_URL}/internet-empresas`,
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  ></script>
  <InternetEmpresasHero />
  <EmpresasSolution />
  <EmpresasStats />
  <EmpresasSectors />
  <WhyChoseEmpresas />
  <ReadyToGetwork />
</Layout>
