---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";

const title =
  "Cobertura de Internet | Playa del Carmen, Tulum y Riviera Maya | Enlaces Playa";
const description =
  "Consulta la cobertura de Internet en Cancún, Playa del Carmen y Tulum. Verifica la disponibilidad de fibra óptica e Internet inalámbrico en tu domicilio.";
const keywords =
  "cobertura de internet, cobertura de internet en cancún, cobertura de internet en playa del carmen, cobertura de internet en tulum, cobertura fibra óptica, cobertura internet inalámbrico";

const zonas = [
  {
    lugar: "Playa del Carmen",
    descripcion:
      "Cobertura en zonas residenciales y comerciales de Playa del Carmen.",
    href: "/cobertura/playa-del-carmen",
  },
  {
    lugar: "Tulum",
    descripcion:
      "Cobertura en el centro de Tulum, la zona hotelera y comunidades cercanas.",
    href: "/cobertura/tulum",
  },
  {
    lugar: "Puerto Morelos",
    descripcion:
      "Cobertura en Puerto Morelos y sus alrededores.",
    href: "/cobertura/puerto-morelos",
  },
];
---

<Layout title={title} description={description} keywords={keywords}>
  <Container>
    <header class="max-w-3xl">
      <h1 class="text-3xl font-bold text-light md:text-5xl">
        Cobertura de Internet
      </h1>
      <p class="mt-4 text-lg text-light/90 md:text-xl">
        {description}
      </p>
    </header>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-accent md:text-3xl">
        Zonas con cobertura
      </h2>
      <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          zonas.map((zona) => (
            <li class="rounded-2xl border border-white/10 bg-white/5 p-6">
              <h3 class="text-xl font-semibold text-light">{zona.lugar}</h3>
              <p class="mt-2 text-sm text-light/80">{zona.descripcion}</p>
              <a
                href={zona.href}
                class="mt-4 inline-flex items-center justify-center rounded-full bg-accent bg-accent-grad-t px-4 py-2 text-sm font-bold text-dark shadow-sm transition-transform hover:scale-[1.03]"
              >
                Ver detalle
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-bold text-accent md:text-3xl">
        ¿No ves tu zona?
      </h2>
      <p class="mt-3 text-light/85">
        Escríbenos para consultar disponibilidad en tu domicilio. Ampliamos
        cobertura de manera continua.
      </p>
      <a
        href="/contacto"
        class="mt-4 inline-flex items-center justify-center rounded-full border border-light/40 px-6 py-3 text-base font-semibold text-light transition-colors hover:border-light/70 hover:bg-light/10"
      >
        Consultar cobertura
      </a>
    </section>
  </Container>
</Layout>
