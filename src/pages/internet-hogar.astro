---
import Layout from "../layouts/Layout.astro";
import InternetHogarHero from "../components/internet-hogar/InternetHogarHero.astro";
import InternetHogarPlans from "../components/internet-hogar/InternetHogarPlans.astro";

const title =
  "Internet para Hogar | Fibra Óptica e Internet Inalámbrico | Enlaces Playa";
const description =
  "Internet para Hogar en Cancún, Playa del Carmen y Tulum. Conoce nuestros planes de fibra óptica e Internet inalámbrico y consulta la cobertura en tu domicilio.";
const keywords =
  "internet para hogar, internet para casa, planes de internet para hogar, fibra óptica, internet inalámbrico para casa, internet en cancún, internet en playa del carmen, internet en tulum";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Internet para Hogar",
  "name": title,
  "description": description,
  "provider": {
    "@type": "Organization",
    "name": "Enlaces Playa",
    "url": "https://enlacesplaya.com.mx/",
  },
  "areaServed": [
    { "@type": "City", "name": "Cancún" },
    { "@type": "City", "name": "Playa del Carmen" },
    { "@type": "City", "name": "Tulum" },
  ],
  "url": "https://enlacesplaya.com.mx/internet-hogar",
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  ></script>
  <InternetHogarHero />
  <InternetHogarPlans />
</Layout>
