---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";

const title =
  "Internet para Hogar | Fibra Óptica e Internet Inalámbrico | Enlaces Playa";
const description =
  "Internet para Hogar en Cancún, Playa del Carmen y Tulum. Conoce nuestros planes de fibra óptica e Internet inalámbrico y consulta la cobertura en tu domicilio.";
const keywords =
  "internet para hogar, internet para casa, planes de internet para hogar, fibra óptica, internet inalámbrico para casa, internet en cancún, internet en playa del carmen, internet en tulum";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Internet para Hogar",
  "name": title,
  "description": description,
  "provider": {
    "@type": "Organization",
    "name": "Enlaces Playa",
    "url": "https://enlacesplaya.com.mx/",
  },
  "areaServed": [
    { "@type": "City", "name": "Cancún" },
    { "@type": "City", "name": "Playa del Carmen" },
    { "@type": "City", "name": "Tulum" },
  ],
  "url": "https://enlacesplaya.com.mx/internet-hogar",
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  ></script>
  <Container>
    <header class="max-w-3xl">
      <h1 class="text-3xl font-bold text-light md:text-5xl">
        Internet para Hogar
      </h1>
      <p class="mt-4 text-lg text-light/90 md:text-xl">
        {description}
      </p>
    </header>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-bold text-accent md:text-3xl">
        Opciones de conexión para tu casa
      </h2>
      <p class="mt-3 text-light/85">
        Ofrecemos dos modalidades para llevar Internet a tu hogar, según la
        cobertura disponible en tu domicilio.
      </p>
      <ul class="mt-6 space-y-4 text-light/85">
        <li>
          <h3 class="text-lg font-semibold text-light">Fibra óptica</h3>
          <p>
            Conexión por cable de fibra hasta el interior del domicilio. Ofrece
            mayor estabilidad y velocidad simétrica, ideal para streaming,
            videollamadas y gaming.
          </p>
        </li>
        <li>
          <h3 class="text-lg font-semibold text-light">Internet inalámbrico</h3>
          <p>
            Conexión por antena receptora en zonas donde la fibra aún no está
            disponible. Permite navegar sin cableado y con instalación rápida.
          </p>
        </li>
      </ul>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-bold text-accent md:text-3xl">
        ¿Cómo contratar Internet para Hogar?
      </h2>
      <ol class="mt-4 list-decimal space-y-2 pl-6 text-light/85">
        <li>Consulta la cobertura en tu domicilio.</li>
        <li>Selecciona el plan que mejor se ajuste a tu uso.</li>
        <li>Agenda la instalación con nuestro equipo técnico local.</li>
      </ol>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-bold text-accent md:text-3xl">
        Consulta la cobertura
      </h2>
      <p class="mt-3 text-light/85">
        Verifica la disponibilidad de fibra óptica o Internet inalámbrico en
        tu zona.
      </p>
      <a
        href="/cobertura"
        class="mt-4 inline-flex items-center justify-center rounded-full bg-accent bg-accent-grad-t px-6 py-3 text-base font-bold text-dark shadow-md transition-transform hover:scale-[1.03]"
      >
        Ver cobertura
      </a>
    </section>
  </Container>
</Layout>
