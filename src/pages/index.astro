---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/sections/Hero.astro";
import Benefits from "../components/home/sections/Benefits.astro";
import Plans from "../components/home/sections/Plans.astro";
import WhyChooseUs from "../components/home/sections/WhyChooseUs.astro";
import CoverageCheck from "../components/home/sections/CoverageCheck.astro";
import Companies from "../components/home/sections/Companies.astro";
import Testimonials from "../components/home/sections/Testimonials.astro";
import FinalCTA from "../components/home/sections/FinalCTA.astro";

const title =
  "Internet en la Riviera Maya | Internet Rápido y Estable | Enlaces Playa";
const description =
  "Internet rápido y estable para Hogar y Empresas en Playa del Carmen, Puerto Morelos y Tulum. Conoce nuestros servicios y consulta la cobertura en tu zona.";
const keywords =
  "internet en la riviera maya, internet en cancún, internet en playa del carmen, internet en tulum, internet para hogar, internet para empresas";

// JSON-LD: Organization + WebSite (datos tomados de los metadatos de la página)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://enlacesplaya.com.mx/#organization",
      "name": "Enlaces Playa",
      "url": "https://enlacesplaya.com.mx/",
      "logo": "https://enlacesplaya.com.mx/images/logos/logo-enlacesplaya.webp",
      "description": description,
      "email": "hola@enlacesplaya.com.mx",
      "telephone": "+52-984-184-5726",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Playa del Carmen",
        "addressRegion": "Quintana Roo",
        "addressCountry": "MX",
      },
      "areaServed": [
        { "@type": "City", "name": "Cancún" },
        { "@type": "City", "name": "Playa del Carmen" },
        { "@type": "City", "name": "Tulum" },
      ],
    },
    {
      "@type": "WebSite",
      "@id": "https://enlacesplaya.com.mx/#website",
      "url": "https://enlacesplaya.com.mx/",
      "name": "Enlaces Playa",
      "description": description,
      "inLanguage": "es-MX",
      "publisher": { "@id": "https://enlacesplaya.com.mx/#organization" },
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  ></script>
  <div class="relative overflow-hidden">
    <Hero />
    <Benefits />
    <Plans />
    <WhyChooseUs />
    <CoverageCheck />
    <Companies />
    <Testimonials />
    <FinalCTA />
  </div>
</Layout>

