---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/sections/Hero.astro";
import Benefits from "../components/home/sections/Benefits.astro";
import Plans from "../components/home/sections/Plans.astro";
import WhyChooseUs from "../components/home/sections/WhyChooseUs.astro";
import CoverageCheck from "../components/home/sections/CoverageCheck.astro";
import Companies from "../components/home/sections/Companies.astro";
import Testimonials from "../components/home/sections/Testimonials.astro";
import FinalCTA from "../components/home/sections/FinalCTA.astro";
import {
  ORGANIZACION_ID,
  SITE_URL,
  WEBSITE_ID,
  organizacionCompleta,
} from "../data/seo";
import { SITE } from "../data/site";

const title =
  "Internet en la Riviera Maya | Internet Rápido y Estable | Enlaces Playa";
const description =
  "Internet rápido y estable para Hogar y Empresas en Playa del Carmen, Puerto Morelos y Tulum. Conoce nuestros servicios y consulta la cobertura en tu zona.";
const keywords =
  "internet en la riviera maya, internet en cancún, internet en playa del carmen, internet en tulum, internet para hogar, internet para empresas";

// JSON-LD: Organization + WebSite (datos tomados de los metadatos de la página)
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    organizacionCompleta(description),
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      "url": `${SITE_URL}/`,
      "name": SITE.nombre,
      "description": description,
      "inLanguage": "es-MX",
      "publisher": { "@id": ORGANIZACION_ID },
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  ></script>
  <div class="relative overflow-hidden">
    <Hero />
    <Benefits />
    <Plans />
    <WhyChooseUs />
    <CoverageCheck />
    <Companies />
    <Testimonials />
    <FinalCTA />
  </div>
</Layout>

