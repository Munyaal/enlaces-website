---
/**
 * src/pages/blog.astro
 *
 * Listado del blog. Consume la Content Collection `blog` (definida en
 * `src/content.config.ts`) y la presenta como un grid de tarjetas en
 * una sección oscura, replicando el lenguaje visual del home:
 *
 *   - Fondo `bg-secondary` para que el texto blanco sea legible y la
 *     página dialogue con el navbar (`bg-secondary/80`) y el footer
 *     (`bg-secondary`) ya existentes.
 *   - Encabezado de tipo hero: `heading-1` con acento en color
 *     `text-primary`, divisor `bg-accent-grad-radial` y lede
 *     `paragraph-md`.
 *   - Entrada escalonada con `revealOnEnter` (respeta
 *     `prefers-reduced-motion`).
 *   - Tarjetas delegadas a `BlogCard.astro` para no duplicar el
 *     markup y mantener la jerarquía del listado en un único sitio.
 */
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import BlogCard from "../components/BlogCard.astro";
import { getCollection } from "astro:content";
import { resolveDisplayTitle } from "../utils/blog";

const title =
  "Blog de Internet | Fibra Óptica, Conectividad y Consejos | Enlaces Playa";
const description =
  "Consejos y guías sobre Internet, fibra óptica, Internet inalámbrico, velocidad y conectividad para tu hogar o negocio.";
const keywords =
  "blog de internet, consejos de internet, fibra óptica, internet inalámbrico, velocidad de internet, internet para hogar";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: title,
  description: description,
  url: "https://enlacesplaya.com.mx/blog",
  inLanguage: "es-MX",
  publisher: {
    "@type": "Organization",
    name: "Enlaces Playa",
    url: "https://enlacesplaya.com.mx/",
  },
};

// Formateo es-MX estable en SSR (sin sorpresas de locale del cliente).
// `timeZone: "UTC"` evita el offset que mete `Intl.DateTimeFormat` cuando
// el frontmatter trae fechas tipo `2026-08-28` (parseadas como medianoche
// UTC por `z.coerce.date()`): sin fijar timezone, la fecha se mostraría
// como el día anterior en zonas horarias al oeste de UTC. Mismo motivo
// por el que `toIsoDate` usa `toISOString().slice(0, 10)` en JSON-LD.
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("es-MX", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(date);

// Mismo formato YYYY-MM-DD que ya se usa en el JSON-LD del detalle
// (`src/pages/blog/[slug].astro`), para que el `datetime` del `<time>`
// sea estable en SSR y consistente entre la tarjeta y el artículo.
const toIsoDate = (date: Date) => date.toISOString().slice(0, 10);

// Ordenamos por fecha de publicación descendente para que el artículo
// más reciente aparezca primero.
const articulos = (await getCollection("blog"))
  .sort((a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime())
  .map((post) => ({
    // Título visible: usa `displayTitle` si existe y, como fallback,
    // elimina el sufijo SEO `| Enlaces Playa` del `title` del
    // frontmatter. El SEO (`<title>` y JSON-LD) sigue usando `title`
    // íntegro.
    titulo: resolveDisplayTitle(post),
    resumen: post.data.summary,
    href: `/blog/${post.id}`,
    category: post.data.category,
    dateLabel: formatDate(post.data.datePublished),
    dateTime: toIsoDate(post.data.datePublished),
  }));
---

<Layout title={title} description={description} keywords={keywords}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  ></script>

  {/* Sección oscura que cubre toda la página. El padding lo aporta
     `Container` para mantener coherencia con el resto del sitio. */}
  <section
    aria-labelledby="blog-list-title"
    class="bg-secondary text-light"
  >
    <Container>
      <header class="max-w-3xl">
        <p
          class="paragraph-xs uppercase tracking-[0.18em] text-accent"
          data-reveal
        >
          Recursos
        </p>
        <h1
          id="blog-list-title"
          class="heading-1 mt-3 text-balance text-light"
          data-reveal
        >
          <span class="text-primary">Blog</span> de Internet en la Riviera
          Maya
        </h1>
        <hr
          aria-hidden="true"
          class="mt-4 h-1 w-32 border-0 bg-accent-grad-radial sm:w-52"
          data-reveal
        />
        <p
          class="paragraph-md mt-5 max-w-3xl text-pretty text-light/90"
          data-reveal
        >
          {description}
        </p>
      </header>

      <section
        aria-labelledby="blog-list-articles-title"
        class="mt-12 lg:mt-16"
      >
        <h2
          id="blog-list-articles-title"
          class="heading-5 text-light"
          data-reveal
        >
          Artículos
        </h2>

        <ul
          role="list"
          class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8"
        >
          {
            articulos.map((art) => (
              <li class="h-full">
                <BlogCard
                  href={art.href}
                  title={art.titulo}
                  summary={art.resumen}
                  category={art.category}
                  dateLabel={art.dateLabel}
                  dateTime={art.dateTime}
                  reveal
                />
              </li>
            ))
          }
        </ul>
      </section>
    </Container>
  </section>
</Layout>

<script>
  import { revealOnEnter } from "../utils/reveal";

  // Encabezado (kicker, h1, hr, lede) entra primero; luego el título
  // "Artículos" y, escalonadas, las tarjetas. ScrollTrigger `once: true`
  // garantiza que la animación sólo se dispara la primera vez que la
  // sección entra al viewport.
  const init = () => {
    const section = document.querySelector(
      "section[aria-labelledby='blog-list-title']",
    );
    if (!section) return;

    revealOnEnter({
      selector: "[data-reveal]",
      root: section,
      stagger: 0.08,
      duration: 0.55,
      y: 18,
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
