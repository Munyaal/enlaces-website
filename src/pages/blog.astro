---
// Listado del blog. Reglas que no deben perderse: las fechas se formatean
// en UTC (si no, se muestra el día anterior al oeste de UTC), el listado
// se oculta con el atributo `hidden` y no con la clase (para que
// `toggleAttribute` funcione) y el reveal de las tarjetas se resetea sólo
// al filtrar, nunca en el arranque.
import Layout from "../layouts/Layout.astro";
import BlogHero from "../components/blog/BlogHero.astro";
import BlogExplorer from "../components/blog/BlogExplorer.astro";
import { getBlogCategories, getBlogPosts } from "../utils/blog";

const title =
  "Blog de Internet | Fibra Óptica, Conectividad y Consejos | Enlaces Playa";
const description =
  "Consejos y guías sobre Internet, fibra óptica, Internet inalámbrico, velocidad y conectividad para tu hogar o negocio.";
const keywords =
  "blog de internet, consejos de internet, fibra óptica, internet inalámbrico, velocidad de internet, internet para hogar";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: title,
  description: description,
  url: "https://enlacesplaya.com.mx/blog",
  inLanguage: "es-MX",
  publisher: {
    "@type": "Organization",
    name: "Enlaces Playa",
    url: "https://enlacesplaya.com.mx/",
  },
};

const posts = await getBlogPosts();
const categories = getBlogCategories(posts);
---

<Layout title={title} description={description} keywords={keywords}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")}
  ></script>

  <BlogHero description={description} />
  <BlogExplorer posts={posts} categories={categories} total={posts.length} />
</Layout>
